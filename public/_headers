# Cloudflare Pages _headers file for melmayan.fr
# Syntax: https://developers.cloudflare.com/pages/configuration/headers/

# Default security headers for all routes
/*
  # Security Headers
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), browsing-topics=()

  # Content Security Policy
  # Tailored for Astro + React + shadcn/ui with theme switching
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

  # Performance & Caching
  # HTML routes land here on purpose. Astro emits pretty URLs (/contact/), and
  # _headers matches the request path, so no *.html pattern can ever target a
  # page. A deploy is therefore visible after at most an hour.
  Cache-Control: public, max-age=3600, must-revalidate

# Immutable hashed assets in /_astro/ directory
# Vite content-hashes ensure cache-busting on changes
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Web fonts with long cache
/_astro/*.woff2
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

# Images with moderate cache
/bg-*-v3.webp
  ! Cache-Control
  Cache-Control: public, max-age=2592000, immutable

/bg-*-v3.jpg
  ! Cache-Control
  Cache-Control: public, max-age=2592000, immutable

/images/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/flags/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/projects/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/projects/*.png
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/projects/*.mp4
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/projects/*.mov
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=2592000

# Per-post markdown (the "copy as markdown" source) served as plain text.
# Cloudflare Pages types .md as text/markdown, which the nosniff header above
# turns into a download instead of a page.
/blog/*.md
  Content-Type: text/plain; charset=utf-8

/en/blog/*.md
  Content-Type: text/plain; charset=utf-8
