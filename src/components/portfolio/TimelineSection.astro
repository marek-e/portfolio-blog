---
import { TimelineCards } from '@/components/portfolio/TimelineCards';
import SectionHeading from '@/components/shared/SectionHeading.astro';
import { getLocalizedTimeline } from '@/data/timeline';
import { getTranslations, getLangFromUrl } from '@/i18n';
import CursorSpotlight from './CursorSpotlight.astro';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const timelineEntries = getLocalizedTimeline(lang);
---

<CursorSpotlight>
  <section id="timeline" class="relative py-12 md:py-24" aria-label={t.timeline.title}>
    <div class="mx-auto max-w-[1440px] px-4 sm:px-8 lg:px-12">
      <SectionHeading
        eyebrow={t.timeline.eyebrow}
        mobileEyebrow={t.timeline.eyebrow.replace(/^02/, '03')}
        title={t.timeline.title}
        subtitle={t.timeline.subtitle}
        align="center"
        class="mb-8 md:mb-24"
      />

      <TimelineCards entries={timelineEntries} presentLabel={t.timeline.present} lang={lang} />
    </div>
  </section>
</CursorSpotlight>

<script>
  function initTimeline() {
    const timeline = document.querySelector<HTMLElement>('.timeline');
    if (!timeline) return;

    const line = timeline.querySelector<HTMLElement>('[data-timeline-line]')!;
    const years = [...timeline.querySelectorAll<HTMLElement>('[data-timeline-year]')];
    const stops = [...timeline.querySelectorAll<SVGStopElement>('#timeline-ink stop')];
    const paths = [...timeline.querySelectorAll<SVGPathElement>('[data-timeline-path]')];
    const cards = [...timeline.querySelectorAll<HTMLElement>('.timeline-card')];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const animations = new Map<HTMLElement, Animation>();

    const updateLine = () => {
      const bounds = line.getBoundingClientRect();
      const offsets = years.map((year) => {
        const badge = year.getBoundingClientRect();
        return ((badge.top + badge.height / 2 - bounds.top) / bounds.height) * 100;
      });

      stops.forEach((stop, index) => stop.setAttribute('offset', `${offsets[index]}%`));

      const { width, height } = line.querySelector('svg')!.viewBox.baseVal;
      const center = width / 2;
      const positions = offsets.map((offset) => (offset / 100) * height);
      let path = `M${center} 0L${center} ${positions[0]}`;

      positions.slice(1).forEach((position, index) => {
        const previous = positions[index];
        const bend = index % 2 === 0 ? width : 0;
        const handle = (position - previous) / 3;
        path += `C${bend} ${previous + handle} ${bend} ${position - handle} ${center} ${position}`;
      });

      path += `L${center} ${height}`;
      paths.forEach((element) => element.setAttribute('d', path));
    };

    const revealCard = (card: HTMLElement) => {
      card.removeAttribute('data-timeline-pending');
      card.dataset.timelineRevealed = '';
      animations.get(card)?.cancel();
      animations.delete(card);
      entranceObserver.unobserve(card.closest('.timeline-item')!);
    };

    const entranceObserver = new IntersectionObserver(
      (observations) => {
        observations.forEach((observation) => {
          if (!observation.isIntersecting) return;
          entranceObserver.unobserve(observation.target);
          const card = observation.target.querySelector<HTMLElement>('.timeline-card')!;
          if (!card.hasAttribute('data-timeline-pending')) return;

          const desktop = window.matchMedia('(min-width: 768px)').matches;
          const direction = desktop && cards.indexOf(card) % 2 === 0 ? -1 : 1;
          const distance = desktop ? window.innerWidth * 0.46 : 16;
          const animation = card.animate(
            [
              {
                opacity: 0,
                transform: `translateX(${direction * distance}px) translateY(${desktop ? 48 : 16}px) rotate(${desktop ? direction * 5 : 0}deg) scale(${desktop ? 0.94 : 1})`,
              },
              { opacity: 1, offset: 0.3 },
              { opacity: 1, transform: 'translateX(0) translateY(0) rotate(0) scale(1)' },
            ],
            {
              duration: desktop ? 700 : 250,
              easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
              fill: 'both',
            }
          );
          animations.set(card, animation);
          animation.onfinish = () => revealCard(card);
        });
      },
      { threshold: 0.18, rootMargin: '0px 0px -8% 0px' }
    );

    if (!reducedMotion.matches) {
      cards.forEach((card) => {
        card.dataset.timelinePending = '';
        entranceObserver.observe(card.closest('.timeline-item')!);
      });
    }

    const revealOnFocus = (event: FocusEvent) => {
      const card = (event.target as HTMLElement).closest<HTMLElement>('.timeline-card');
      if (card) revealCard(card);
    };
    const revealForReducedMotion = () => {
      if (reducedMotion.matches) cards.forEach(revealCard);
    };
    const resizeObserver = new ResizeObserver(updateLine);
    resizeObserver.observe(timeline);
    timeline.addEventListener('focusin', revealOnFocus);
    reducedMotion.addEventListener('change', revealForReducedMotion);

    document.addEventListener(
      'astro:before-swap',
      () => {
        resizeObserver.disconnect();
        entranceObserver.disconnect();
        cards.forEach(revealCard);
        timeline.removeEventListener('focusin', revealOnFocus);
        reducedMotion.removeEventListener('change', revealForReducedMotion);
      },
      { once: true }
    );
  }

  initTimeline();
  document.addEventListener('astro:after-swap', initTimeline);
</script>

<style>
  :global(.timeline-card[data-timeline-pending]) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.timeline-card[data-timeline-pending]) {
      opacity: 1;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(.timeline) {
        view-timeline: --timeline block;
        view-timeline-inset: 0 45%;
      }

      :global(.timeline-progress) {
        animation: timeline-draw linear both;
        animation-timeline: --timeline;
        animation-range: entry 0% exit 0%;
      }
    }
  }

  @keyframes timeline-draw {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
