---
import { Link } from '@/components/ui/button';
import { Card3D } from '@/components/ui/card-3d';
import { HugeiconsIcon } from '@hugeicons/react';
import { Sent02Icon } from '@hugeicons/core-free-icons';
import { EMAIL } from '@/lib/socials';
import { getTranslations, getLangFromUrl } from '@/i18n';
import { CopyEmailButton } from '@/components/portfolio/CopyEmailButton';
import { ContactSocialLinks } from '@/components/portfolio/ContactSocialLinks';
import { Doodle } from '@/components/shared/HandDrawn';
import SectionHeading from '@/components/shared/SectionHeading.astro';

interface Props {
  as?: 'h1' | 'h2';
}

const { as = 'h2' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const isPage = as === 'h1';
---

<section
  id="contact"
  class="relative pt-12 pb-12 md:pt-24 md:pb-20"
  aria-labelledby="contact-title"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="contact-stage relative isolate">
      <div
        class="contact-backdrop pointer-events-none absolute -inset-x-3 -inset-y-8 -z-10 overflow-hidden rounded-[4.75rem] sm:-inset-x-8"
        aria-hidden="true"
      >
        <img
          src="/images/dev-id-ribbon.webp"
          alt=""
          width="1024"
          height="1024"
          loading="lazy"
          class="contact-ribbon absolute -bottom-32 -left-40 w-80 max-w-none rotate-12 sm:-bottom-56 sm:-left-28 sm:w-[34rem]"
        />
        <img
          src="/images/dev-id-ribbon.webp"
          alt=""
          width="1024"
          height="1024"
          loading="lazy"
          class="contact-ribbon absolute -top-32 -right-40 w-80 max-w-none -rotate-12 sm:-top-56 sm:-right-28 sm:w-[34rem]"
        />
      </div>
      <Card3D
        variant="glass"
        className="gap-0 overflow-hidden px-4 py-10 text-center sm:px-10 sm:py-16 md:px-16 md:py-24"
      >
        <SectionHeading
          title={t.contact.title}
          id="contact-title"
          as={as}
          eyebrow={isPage ? undefined : t.contact.eyebrow}
          subtitle={t.contact.subtitle}
          align="center"
          class="md:[&_h1]:text-7xl md:[&_h2]:text-7xl"
        />

        <div
          class="relative mx-auto mt-8 flex w-full max-w-md flex-col items-stretch justify-center gap-3 sm:w-fit sm:max-w-none sm:flex-row sm:items-center md:mt-12"
        >
          <Doodle
            name="loop"
            strokeWidth={2.5}
            className="text-foreground/40 absolute top-1/2 right-full mr-5 hidden h-14 w-40 -translate-y-1/3 lg:block"
          />
          <Link
            size="lg"
            className="gap-2"
            href={`mailto:${EMAIL}`}
            animation="scale"
            aria-label={t.aria.sendEmail}
          >
            {t.contact.cta}
            <HugeiconsIcon icon={Sent02Icon} className="size-4" data-icon="inline-end" />
          </Link>
          <CopyEmailButton copiedText={t.contact.copied} copyLabel={t.aria.copyEmail} client:load />
        </div>

        <div class="mt-8 flex flex-col items-center gap-4 md:mt-14">
          <p class="eyebrow">{t.contact.socialIntro}</p>
          <ContactSocialLinks followLabel={t.aria.followOn} />
        </div>
      </Card3D>
    </div>
  </div>
</section>

<style>
  .contact-ribbon {
    opacity: 0.55;
  }

  .contact-backdrop {
    mask-image:
      linear-gradient(to right, transparent, black 2rem, black calc(100% - 2rem), transparent),
      linear-gradient(to bottom, transparent, black 2rem, black calc(100% - 2rem), transparent);
    mask-composite: intersect;
  }

  :global(.dark) .contact-ribbon {
    filter: hue-rotate(265deg) saturate(0.75);
    opacity: 0.4;
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .contact-stage :global(.card-3d-material) {
      background: var(--card);
    }
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .contact-backdrop {
      display: none;
    }

    .contact-stage :global(.card-3d-material) {
      background: var(--card);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>
