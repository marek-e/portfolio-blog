---
import { Link } from '@/components/ui/button';
import { HugeiconsIcon } from '@hugeicons/react';
import { Sent02Icon } from '@hugeicons/core-free-icons';
import { EMAIL, SOCIALS } from '@/lib/socials';
import { getTranslations, getLangFromUrl } from '@/i18n';
import { CopyEmailButton } from '@/components/portfolio/CopyEmailButton';
import { Doodle } from '@/components/shared/HandDrawn';
import SectionHeading from '@/components/shared/SectionHeading.astro';

interface Props {
  as?: 'h1' | 'h2';
}

const { as = 'h2' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const isPage = as === 'h1';
---

<section
  id="contact"
  class="relative pt-20 pb-16 md:pt-24 md:pb-20"
  aria-labelledby="contact-title"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div
      class="glass relative isolate overflow-hidden rounded-[2.5rem] px-6 py-16 text-center sm:px-10 md:px-16 md:py-24"
    >
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <span
          class="bg-pastel-peach/60 dark:bg-pastel-peach/12 absolute -top-24 -left-20 size-80 rounded-full blur-3xl"
        ></span>
        <span
          class="bg-pastel-lilac/55 dark:bg-pastel-lilac/14 absolute -right-24 -bottom-28 size-96 rounded-full blur-3xl"
        ></span>
        <span
          class="bg-pastel-sky/45 dark:bg-pastel-sky/10 absolute bottom-0 left-1/3 size-64 rounded-full blur-3xl"
        ></span>
      </div>

      <SectionHeading
        title={t.contact.title}
        id="contact-title"
        as={as}
        eyebrow={isPage ? undefined : t.contact.eyebrow}
        subtitle={t.contact.subtitle}
        align="center"
        class="md:[&_h1]:text-7xl md:[&_h2]:text-7xl"
      />

      <div
        class="relative mx-auto mt-12 flex w-full max-w-md flex-col items-stretch justify-center gap-3 sm:w-fit sm:max-w-none sm:flex-row sm:items-center"
      >
        <Doodle
          name="loop"
          strokeWidth={2.5}
          className="text-foreground/40 absolute top-1/2 right-full mr-5 hidden h-14 w-40 -translate-y-1/3 lg:block"
        />
        <Link
          size="lg"
          className="gap-2"
          href={`mailto:${EMAIL}`}
          animation="scale"
          aria-label={t.aria.sendEmail}
        >
          {t.contact.cta}
          <HugeiconsIcon icon={Sent02Icon} className="size-4" data-icon="inline-end" />
        </Link>
        <CopyEmailButton copiedText={t.contact.copied} copyLabel={t.aria.copyEmail} client:load />
      </div>

      <div class="mt-14 flex flex-col items-center gap-4">
        <p class="eyebrow">{t.contact.socialIntro}</p>
        <ul class="flex items-center justify-center gap-3">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={t.aria.followOn.replace('{platform}', social.name)}
                  class="glass group text-foreground/75 hover:text-primary focus-visible:ring-ring flex size-12 items-center justify-center rounded-full transition duration-300 outline-none focus-visible:ring-2"
                >
                  <HugeiconsIcon
                    icon={social.icon}
                    className="motion-safe:group-hover:animate-wiggle size-5"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
