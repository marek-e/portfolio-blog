---
import { getCollection } from 'astro:content';
import CraftObject from '@/components/brand/CraftObject.astro';
import Sketch from '@/components/brand/Sketch.astro';
import ProjectListCard from './ProjectListCard.astro';
import { getTranslations, getLangFromUrl, getTranslatedPath } from '@/i18n';
import { sortProjects } from '@/lib/projects';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);
const projects = sortProjects(
  (await getCollection('projects')).filter(
    (project) => project.id.startsWith(`${lang}/`) && project.data.featured
  )
).slice(0, 4);
---

<section id="projects" class="chapter section-shell" aria-labelledby="projects-heading">
  <div class="section-heading">
    <CraftObject kind="code" class="section-object" />
    <Sketch kind="orbit" class="heading-sketch" />
    <div>
      <p class="eyebrow">
        01 / {lang === 'fr' ? 'De l’idée au produit' : 'From idea to product'}
      </p><h2 id="projects-heading">
        {lang === 'fr' ? 'Des idées qui prennent vie.' : 'Ideas, brought to life.'}
      </h2><p class="section-intro">{t.projects.subtitle}</p>
    </div>
    <a href={translatePath('/projects')} class="text-link">{t.projects.viewAll}</a>
  </div>
  <div class="featured-grid">
    {
      projects.map((project, index) => (
        <ProjectListCard project={project} tone={['lilac', 'peach', 'sky', 'sage'][index % 4]} />
      ))
    }
  </div>
</section>
