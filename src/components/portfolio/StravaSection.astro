---
import { getRunningActivities, getAthleteStats, STRAVA_ATHLETE_ID } from '@/lib/strava';
import { ActivityCard } from '@/components/portfolio/ActivityCard';
import { RaceActivityCard } from '@/components/portfolio/RaceActivityCard';
import { LongRunActivityCard } from '@/components/portfolio/LongRunActivityCard';
import { IntervalsActivityCard } from '@/components/portfolio/IntervalsActivityCard';
import { CommuteActivityCard } from '@/components/portfolio/CommuteActivityCard';
import { RunningStats } from '@/components/portfolio/RunningStats';
import { getTranslations, getLangFromUrl } from '@/i18n';
import type { RunningActivity, RunningStats as RunningStatsType } from '@/types/strava';
import SectionHeading from '@/components/shared/SectionHeading.astro';
import { Link } from '@/components/ui/button';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);

let activities: RunningActivity[] = [];
let stats: RunningStatsType | null = null;

try {
  const [fetchedActivities, fetchedStats] = await Promise.all([
    getRunningActivities(6),
    getAthleteStats(),
  ]);

  if (fetchedActivities.length > 0) {
    activities = fetchedActivities;
    stats = fetchedStats;
  }
} catch (error) {
  console.warn('[StravaSection] Failed to fetch Strava data:', error);
}

const stravaOrange = '#FC4C02';
const stravaLogoPath =
  'M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169';
const hasData = activities.length > 0;
---

<section id="running" class="relative py-20 md:py-24" aria-labelledby="running-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      id="running-title"
      eyebrow={t.strava.eyebrow}
      title={t.strava.title}
      subtitle={t.strava.subtitle}
      class="mb-8"
    >
      <Link
        variant="glass"
        href={`https://www.strava.com/athletes/${STRAVA_ATHLETE_ID}`}
        target="_blank"
        rel="noopener noreferrer"
        className="hidden md:inline-flex"
      >
        <svg viewBox="0 0 24 24" class="size-4" fill={stravaOrange} aria-hidden="true">
          <path d={stravaLogoPath}></path>
        </svg>
        {t.strava.viewOnStrava}
      </Link>
    </SectionHeading>

    <p class="text-muted-foreground mb-12 max-w-3xl text-lg leading-relaxed text-pretty">
      {t.strava.intro}
    </p>

    {
      hasData ? (
        <>
          {stats && (
            <div class="mb-6 md:mb-8">
              <RunningStats client:visible stats={stats} lang={lang} />
            </div>
          )}

          {/* Activities Grid */}
          <div class="grid gap-4 sm:grid-cols-2 md:gap-5 lg:grid-cols-3">
            {activities.map((activity) =>
              activity.runType === 'race' ? (
                <RaceActivityCard client:visible activity={activity} lang={lang} />
              ) : activity.runType === 'longRun' ? (
                <LongRunActivityCard client:visible activity={activity} lang={lang} />
              ) : activity.runType === 'intervals' ? (
                <IntervalsActivityCard client:visible activity={activity} lang={lang} />
              ) : activity.runType === 'commute' ? (
                <CommuteActivityCard client:visible activity={activity} lang={lang} />
              ) : (
                <ActivityCard client:visible activity={activity} lang={lang} />
              )
            )}
          </div>
        </>
      ) : (
        <div class="glass flex flex-col items-center justify-center gap-6 rounded-3xl p-10">
          <p class="text-muted-foreground text-center">{t.strava.noActivities}</p>
          <Link
            size="lg"
            href={`https://www.strava.com/athletes/${STRAVA_ATHLETE_ID}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" class="size-4" fill={stravaOrange} aria-hidden="true">
              <path d={stravaLogoPath} />
            </svg>
            {t.strava.viewOnStrava}
          </Link>
        </div>
      )
    }

    <!-- Mobile Strava Link (only show if we have data) -->
    {
      hasData && (
        <div class="mt-8 flex justify-center md:hidden">
          <Link
            variant="glass"
            size="lg"
            href={`https://www.strava.com/athletes/${STRAVA_ATHLETE_ID}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" class="size-4" fill={stravaOrange} aria-hidden="true">
              <path d={stravaLogoPath} />
            </svg>
            {t.strava.viewOnStrava}
          </Link>
        </div>
      )
    }
  </div>
</section>
