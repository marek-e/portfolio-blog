---
import { Image } from 'astro:assets';
import { HeroActions } from './HeroActions';
import { HeroStickers } from './HeroStickers';
import { Doodle, MarkedText } from '@/components/shared/HandDrawn';
import { getTranslations, getLangFromUrl, getTranslatedPath } from '@/i18n';
import BackgroundImage from '@/components/layout/BackgroundImage.astro';
import CursorSpotlight from './CursorSpotlight.astro';
import portrait from '@/assets/mareke.avif';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);
---

<CursorSpotlight>
  <section class="relative flex min-h-dvh items-center justify-center overflow-hidden pt-28 pb-20">
    <BackgroundImage />

    <HeroStickers client:load badges={t.hero.badges} floating />

    <div
      class="relative z-10 mx-auto flex w-full max-w-5xl min-w-0 flex-col items-center px-4 text-center sm:px-6"
    >
      <p
        class="liquid-glass hero-identity relative mb-10 flex max-w-full items-center gap-3 rounded-full py-1.5 pr-4 pl-1.5 text-sm"
      >
        <Image
          src={portrait}
          alt=""
          width={56}
          height={56}
          class="size-7 rounded-full object-cover"
          loading="eager"
        />
        <span class="text-foreground font-mono text-xs tracking-wide">{t.hero.eyebrow}</span>
      </p>

      <h1
        id="hello"
        class="text-foreground relative text-[clamp(2.25rem,11.5vw,7.5rem)] leading-[0.95] font-medium tracking-[-0.035em] drop-shadow-[0_2px_24px_oklch(1_0_0/45%)] dark:text-white dark:drop-shadow-[0_2px_24px_oklch(0_0_0/55%)]"
      >
        <span class="block">{t.hero.greeting}</span>
        <span class="relative mt-2 inline-block">
          <MarkedText>{t.hero.name}</MarkedText>
          <Doodle
            name="sparkle"
            className="text-pastel-lilac absolute -top-[0.2em] -right-[0.55em] size-[0.42em] rotate-12"
          />
          <Doodle
            name="sparkle"
            className="text-pastel-peach absolute top-[0.05em] -left-[0.5em] size-[0.24em] -rotate-12"
          />
        </span>
      </h1>

      <p
        class="text-foreground/85 mx-auto mt-10 max-w-2xl text-lg leading-relaxed text-pretty drop-shadow-md md:text-xl dark:text-white/90"
      >
        {
          t.hero.subtitle.split('\n').map((line, i) => (
            <>
              {i > 0 && <br class="hidden md:block" />}
              {i > 0 && ' '}
              {line}
            </>
          ))
        }
      </p>

      <div
        class="relative mt-10 flex w-full flex-col items-center justify-center gap-4 sm:w-auto sm:flex-row sm:gap-5"
      >
        <Doodle
          name="arrow"
          strokeWidth={2.5}
          className="text-foreground/50 absolute top-1/2 -left-32 hidden h-14 w-24 -translate-y-3/4 md:block"
        />
        <HeroActions
          client:load
          projectsLabel={t.hero.ctaProjects}
          cvLabel={t.hero.ctaCv}
          cvHref={translatePath('/curriculum-vitae')}
        />
      </div>

      <HeroStickers client:load badges={t.hero.badges} />
    </div>

    <a
      href="#about"
      data-scroll-hint
      class="scroll-hint absolute bottom-8 left-1/2 z-10 hidden -translate-x-1/2 flex-col items-center gap-3 font-mono text-[0.7rem] tracking-[0.3em] text-white/85 uppercase transition-colors hover:text-white md:flex"
    >
      {t.hero.scrollHint}
      <span class="relative h-12 w-px overflow-hidden bg-white/30">
        <span class="scroll-hint-dot absolute inset-x-0 top-0 h-4 bg-white"></span>
      </span>
    </a>
  </section>
</CursorSpotlight>

<style>
  .scroll-hint {
    text-shadow: 0 1px 10px oklch(0 0 0 / 65%);
    filter: drop-shadow(0 1px 6px oklch(0 0 0 / 45%));
  }

  .scroll-hint[hidden] {
    display: none;
  }

  .scroll-hint-dot {
    animation: scroll-hint 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes scroll-hint {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(300%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint-dot {
      animation: none;
    }
  }
</style>

<script>
  function initScrollHint() {
    const hint = document.querySelector<HTMLAnchorElement>('[data-scroll-hint]');
    if (!hint) return;

    const updateVisibility = () => {
      const hidden = window.scrollY > 0;
      if (hint.hidden !== hidden) hint.hidden = hidden;
    };

    updateVisibility();
    window.addEventListener('scroll', updateVisibility, { passive: true });
    document.addEventListener(
      'astro:before-swap',
      () => window.removeEventListener('scroll', updateVisibility),
      { once: true }
    );
  }

  function initStickerParallax() {
    const layer = document.querySelector<HTMLElement>('[data-sticker-layer]');
    const section = layer?.closest('section');
    if (!layer || !section) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;

    let frame = 0;
    section.addEventListener('pointermove', (event) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const rect = section.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        layer.style.setProperty('--px', x.toFixed(3));
        layer.style.setProperty('--py', y.toFixed(3));
      });
    });

    section.addEventListener('pointerleave', () => {
      layer.style.setProperty('--px', '0');
      layer.style.setProperty('--py', '0');
    });
  }

  initStickerParallax();
  initScrollHint();
  document.addEventListener('astro:after-swap', initStickerParallax);
  document.addEventListener('astro:after-swap', initScrollHint);
</script>
