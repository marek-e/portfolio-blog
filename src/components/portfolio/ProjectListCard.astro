---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getTranslations, getTranslatedPath, getLangFromUrl } from '@/i18n';
import { getProjectSlug, formatProjectDate } from '@/lib/projects';
import { getProjectImageSafe } from '@/lib/images';

interface Props {
  project: CollectionEntry<'projects'>;
  tone?: string;
}

const { project, tone = 'lilac' } = Astro.props;
const { title, description, techStack, image, imageAlt, objectFit, publishDate, status } =
  project.data;
const projectImage = getProjectImageSafe(image);
const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);
const projectUrl = translatePath(`/projects/${getProjectSlug(project.id, lang)}`);
const statusKey = `status${status.charAt(0).toUpperCase()}${status.slice(1).replace('-', '')}` as
  'statusCompleted' | 'statusInprogress' | 'statusArchived' | 'statusConcept';
---

<article>
  <a href={projectUrl} class="project-card" data-tone={tone}>
    <div
      class="project-artwork"
      data-preview={projectImage && projectImage.width / projectImage.height > 1.35
        ? true
        : undefined}
    >
      {
        projectImage ? (
          <Image
            src={projectImage}
            alt={imageAlt || title}
            style={{ objectFit }}
            loading="lazy"
            widths={[400, 700, 1000]}
            sizes="(max-width: 767px) 90vw, 45vw"
          />
        ) : (
          <span class="handwritten">{title}</span>
        )
      }
      <span class="project-arrow" aria-hidden="true">↗︎</span>
    </div>
    <div class="project-copy">
      <div class="project-meta eyebrow">
        <time datetime={publishDate.toISOString()}>{formatProjectDate(publishDate, lang)}</time>{
          status !== 'completed' && <span>{t.projectsPage[statusKey]}</span>
        }
      </div>
      <h3>{title}</h3>
      <p>{description}</p>
      <div class="interest-tags">{techStack.map((tech) => <span>{tech}</span>)}</div>
    </div>
  </a>
</article>
