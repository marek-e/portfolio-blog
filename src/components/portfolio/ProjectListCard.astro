---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { Badge } from '@/components/ui/badge';
import { getTranslations, getTranslatedPath, getLangFromUrl } from '@/i18n';
import { getProjectSlug, getTechColor, formatProjectDate } from '@/lib/projects';
import { getProjectImageSafe } from '@/lib/images';
import { Icon } from '@/components/shared/Icon';
import { ArrowUpRight01Icon } from '@hugeicons/core-free-icons';
import { cn } from '@/lib/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  class?: string;
}

const { project, index = 0, class: className } = Astro.props;
const { title, description, techStack, image, imageAlt, objectFit, publishDate, status } =
  project.data;
const projectImage = getProjectImageSafe(image);

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);
const projectSlug = getProjectSlug(project.id, lang);
const projectUrl = translatePath(`/projects/${projectSlug}`);

const statusKey = `status${status.charAt(0).toUpperCase()}${status.slice(1).replace('-', '')}` as
  'statusCompleted' | 'statusInprogress' | 'statusArchived' | 'statusConcept';

const panelTones = [
  'bg-pastel-sky/50 dark:bg-pastel-sky/12',
  'bg-pastel-peach/55 dark:bg-pastel-peach/12',
  'bg-pastel-lilac/50 dark:bg-pastel-lilac/12',
  'bg-pastel-mint/55 dark:bg-pastel-mint/12',
  'bg-pastel-butter/70 dark:bg-pastel-butter/12',
  'bg-pastel-rose/50 dark:bg-pastel-rose/12',
];
const panelTone = panelTones[index % panelTones.length];
const isCover = objectFit === 'cover';
---

<article class={cn('group h-full', className)}>
  <a
    href={projectUrl}
    class="surface text-card-foreground focus-visible:ring-ring/50 flex h-full flex-col rounded-3xl p-2 transition duration-300 ease-out outline-none hover:-translate-y-0.5 hover:shadow-lg focus-visible:ring-[3px] motion-reduce:hover:translate-y-0"
  >
    {
      projectImage && (
        <div
          class={cn(
            'relative aspect-16/10 overflow-hidden rounded-[1.25rem] lg:aspect-auto lg:h-64',
            panelTone,
            !isCover && 'p-8 md:p-10'
          )}
        >
          <Image
            src={projectImage}
            alt={imageAlt || `Screenshot of ${title}`}
            class={cn(
              'h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:group-hover:scale-100',
              !isCover && 'drop-shadow-[0_12px_24px_oklch(0.3_0.04_300/0.18)]'
            )}
            style={{ objectFit }}
            loading="lazy"
          />
          <div class="absolute inset-x-3 top-3 flex items-start justify-between gap-2">
            {status && status !== 'completed' ? (
              <Badge variant="outline">
                <span
                  class={cn(
                    'size-1.5 rounded-full',
                    status === 'in-progress' ? 'bg-marker' : 'bg-muted-foreground'
                  )}
                />
                {t.projectsPage[statusKey]}
              </Badge>
            ) : null}
          </div>
        </div>
      )
    }

    <div class="flex flex-1 flex-col gap-4 px-4 pt-5 pb-4 md:px-5">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <time
            datetime={publishDate.toISOString()}
            class="text-muted-foreground font-mono text-xs"
          >
            {formatProjectDate(publishDate, lang)}
          </time>
          <h3
            class="font-display-soft text-foreground mt-1 text-2xl leading-tight font-semibold tracking-tight"
          >
            {title}
          </h3>
        </div>
        <span
          aria-hidden="true"
          class="border-foreground/10 text-foreground group-hover:bg-foreground group-hover:text-background mt-1 grid size-10 shrink-0 place-items-center rounded-full border transition-colors"
        >
          <Icon
            icon={ArrowUpRight01Icon}
            strokeWidth={2}
            className="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </span>
      </div>

      <p class="text-muted-foreground line-clamp-2 flex-1 leading-relaxed">
        {description}
      </p>

      <div class="flex flex-wrap gap-1.5">
        {techStack.slice(0, 3).map((tech) => <Badge variant={getTechColor(tech)}>{tech}</Badge>)}
        {techStack.length > 3 && <Badge variant="outline">+{techStack.length - 3}</Badge>}
      </div>
      <span class="sr-only">{t.projects.viewDetails}</span>
    </div>
  </a>
</article>
