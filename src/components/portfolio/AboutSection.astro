---
import { getTranslations, getLangFromUrl } from '@/i18n';
import { DevIdCard } from '@/components/portfolio/DevIdCard';
import { BIRTH_DATE, getAge } from '@/components/portfolio/DevIdCard/constants';
import { Doodle } from '@/components/shared/HandDrawn';
import SectionHeading from '@/components/shared/SectionHeading.astro';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);

const [lead, ...rest] = t.about.paragraphs;
const beforeMantra = rest.slice(0, 1);
const afterMantra = rest.slice(1);
---

<section id="about" class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-32 lg:px-8">
  <SectionHeading
    eyebrow={t.about.eyebrow}
    mobileEyebrow={t.about.eyebrow.replace(/^01/, '02')}
    title={t.about.title}
  />

  <div class="mt-8 grid gap-8 md:mt-14 md:gap-14 lg:mt-20 lg:grid-cols-12 lg:gap-16">
    <div class="min-w-0 lg:col-span-5">
      <div class="lg:sticky lg:top-28">
        <DevIdCard client:visible lang={lang} ageAtBuild={getAge(BIRTH_DATE)} />
      </div>
    </div>

    <div
      class="text-foreground/75 min-w-0 space-y-6 text-lg leading-relaxed text-pretty lg:col-span-7"
    >
      <p
        class="text-foreground/90 md:font-display-soft hidden text-lg leading-relaxed md:block md:text-[1.4rem] md:leading-normal md:tracking-tight"
        set:html={lead}
      />
      <p class="md:hidden">{t.about.summary}</p>
      <div class="hidden space-y-6 md:block">
        {beforeMantra.map((paragraph) => <p set:html={paragraph} />)}
      </div>

      <figure class="relative !my-8 py-2 md:!my-16 md:pl-10">
        <span
          aria-hidden="true"
          class="font-display-wonk text-marker/70 absolute -top-5 -left-1 text-6xl leading-none select-none md:-top-8 md:left-0 md:text-8xl"
          >“</span
        >
        <blockquote
          class="font-display-wonk text-foreground relative text-2xl leading-[1.25] tracking-tight text-balance md:text-[2.5rem]"
        >
          <p>{t.about.mantraContent}</p>
        </blockquote>
        <figcaption class="eyebrow mt-6 flex items-center gap-3">
          <Doodle name="loop" strokeWidth={2.5} className="text-pastel-lilac h-5 w-16" />
          {t.about.mantraTitle}
        </figcaption>
      </figure>

      <div class="hidden space-y-6 md:block">
        {afterMantra.map((paragraph) => <p set:html={paragraph} />)}
      </div>
      <details class="group md:hidden">
        <summary
          class="text-primary flex min-h-11 w-fit cursor-pointer items-center gap-2 rounded-full font-sans text-sm font-medium"
        >
          <span class="group-open:hidden">{t.about.readMore}</span>
          <span class="hidden group-open:inline">{t.about.readLess}</span>
        </summary>
        <div class="mt-4 space-y-6">
          {[lead, ...beforeMantra, ...afterMantra].map((paragraph) => <p set:html={paragraph} />)}
        </div>
      </details>
    </div>
  </div>
</section>
