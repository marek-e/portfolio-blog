---
import Sketch from '@/components/brand/Sketch.astro';
import { getTranslations, getLangFromUrl } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
---

<section id="about" class="chapter about-chapter" aria-labelledby="about-heading">
  <div class="section-shell about-layout">
    <aside class="portrait-note">
      <Sketch kind="botanical" />
      <div class="portrait-frame">
        <img
          src="/images/marek-profile.webp"
          width="400"
          height="400"
          alt="Marek Elmayan"
          loading="lazy"
        />
      </div>
      <p class="handwritten">{lang === 'fr' ? 'Marek, enchanté !' : 'Marek, nice to meet you!'}</p>
      <p class="eyebrow">Nantes, France</p>
      <div class="interest-tags">
        {
          [
            'UX',
            lang === 'fr' ? 'Cybersécurité' : 'Cybersecurity',
            'AI',
            'DevX',
            'Open source',
          ].map((tag) => <span>{tag}</span>)
        }
      </div>
    </aside>
    <div class="about-story">
      <p class="eyebrow">02 / {t.about.title}</p>
      <h2 id="about-heading">
        {lang === 'fr' ? 'Tout commence par' : 'It all starts with'}<br /><em
          >{lang === 'fr' ? '« et si… »' : '“what if…”'}</em
        >
      </h2>
      <div class="story-paragraphs">
        {t.about.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
      </div>
      <blockquote class="personal-mantra">
        <span aria-hidden="true">✧</span><p>{t.about.mantraContent}</p>
      </blockquote>
    </div>
  </div>
</section>
