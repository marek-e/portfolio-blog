---
import { ModeToggle } from '@/components/layout/ModeToggle';
import { MobileMenu } from '@/components/layout/MobileMenu';
import { getNavLinks } from '@/lib/navigation';
import { getAlternatePath, getLangFromUrl, getTranslatedPath, getTranslations } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
const translatePath = getTranslatedPath(lang);
const navLinks = getNavLinks(lang);
const t = getTranslations(lang);
const currentPath = Astro.url.pathname;
const languagePath = currentPath.startsWith('/404') ? translatePath('/') : currentPath;
const targetLang = lang === 'fr' ? 'en' : 'fr';
---

<header class="site-header">
  <nav class="glass-nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
    <a href={translatePath('/')} aria-label={t.aria.homeLink} class="wordmark">
      <span class="brand-spark" aria-hidden="true">✧</span>
      <span>marek<span class="text-primary">.</span></span>
    </a>
    <div class="nav-destinations hidden items-center gap-1 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link"
            aria-current={
              !link.external && currentPath.replace(/\/$/, '') === link.href.replace(/\/$/, '')
                ? 'page'
                : undefined
            }
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
            {link.external && (
              <span aria-hidden="true" class="nav-external">
                ↗︎
              </span>
            )}
          </a>
        ))
      }
    </div>
    <span class="nav-divider hidden md:block" aria-hidden="true"></span>
    <a
      class="language-link"
      href={getAlternatePath(languagePath, lang, targetLang)}
      lang={targetLang}
      aria-label={targetLang === 'en' ? 'Switch to English' : 'Passer en français'}
      >{targetLang.toUpperCase()}</a
    >
    <ModeToggle client:load />
    <MobileMenu client:load lang={lang} currentPath={languagePath} />
  </nav>
</header>
