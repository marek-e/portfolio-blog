---
import { ModeToggle } from '@/components/layout/ModeToggle';
import { LanguageSwitcher } from '@/components/layout/LanguageSwitcher';
import { NavHoverPill } from '@/components/layout/NavHoverPill';
import MobileTabBar from '@/components/layout/MobileTabBar.astro';
import { Icon } from '@/components/shared/Icon';
import AnimatedLogo from '@/components/layout/AnimatedLogo.astro';
import { getNavLinks } from '@/lib/navigation';
import { getLangFromUrl, getTranslatedPath, getTranslations } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
const translatePath = getTranslatedPath(lang);
const navLinks = getNavLinks(lang);
const t = getTranslations(lang);
const currentPath = Astro.url.pathname;

const linksClasses =
  'text-foreground/80 hover:text-foreground flex items-center gap-2 relative z-10 rounded-full px-3 py-1.5 text-sm transition-colors';
---

<nav class="fixed top-6 left-1/2 z-50 w-fit -translate-x-1/2">
  <div class="navbar-glass liquid-glass relative flex items-center gap-6 rounded-full px-6 py-3">
    <a
      href={translatePath('/')}
      aria-label={t.aria.homeLink}
      class="text-foreground group/logo flex items-center gap-2 font-semibold transition-all duration-300 ease-in-out hover:opacity-80 motion-reduce:hover:underline"
    >
      <AnimatedLogo class="size-8" />
    </a>

    <div id="nav-links" class="relative hidden items-center gap-1 md:flex">
      <NavHoverPill client:load />
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={linksClasses}
            data-nav-link
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <Icon icon={link.icon} strokeWidth={2} className="size-4" />
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-6">
      <LanguageSwitcher currentLang={lang} currentPath={currentPath} className="md:hidden" />
      <ModeToggle client:load />
    </div>
  </div>
</nav>

<MobileTabBar />

<style>
  :global(html:not(.dark) .navbar-glass) {
    --liquid-fill: oklch(0.99 0.005 80 / 26%);
    --liquid-elevation:
      0 2px 4px -1px oklch(0.3 0.025 55 / 8%), 0 14px 32px -12px oklch(0.3 0.025 55 / 20%);
    border-color: oklch(from var(--foreground) l c h / 14%);
  }

  :global(.nav-hover-pill) {
    --depth-tint: var(--primary);
    --depth-white: oklch(from var(--primary) 0.97 0.025 h);
    --depth-core: color-mix(in oklab, var(--primary) 40%, var(--card));
    --depth-rim: color-mix(in oklab, var(--primary) 54%, var(--card));
    --depth-refraction: oklch(from var(--primary) 0.92 0.06 h);
    position: absolute;
    top: 0;
    left: 0;
    isolation: isolate;
    border-radius: 999px;
    background: oklch(from var(--primary) l c h / 18%);
    box-shadow: 0 4px 9px -5px oklch(from var(--primary) 0.4 0.09 h / 30%);
    opacity: 0;
    transform-origin: top left;
    transition: opacity 160ms cubic-bezier(0.23, 1, 0.32, 1);
    pointer-events: none;
  }

  :global(.nav-hover-pill > .glass-material) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    overflow: visible;
    opacity: 0.78;
    pointer-events: none;
  }

  :global(.dark .nav-hover-pill) {
    --depth-white: oklch(from var(--primary) 0.92 0.04 h);
    --depth-core: color-mix(in oklab, var(--primary) 36%, var(--card));
    --depth-rim: color-mix(in oklab, var(--primary) 54%, var(--card));
    --depth-refraction: oklch(from var(--primary) 0.82 0.085 h);
  }

  :global(.nav-hover-pill .glass-reflections) {
    opacity: 0.6;
  }
</style>

<script>
  function initNavPillEffect() {
    const container = document.getElementById('nav-links');
    const pill = document.getElementById('nav-pill');
    const links = document.querySelectorAll('[data-nav-link]');

    if (container && pill) {
      let movement: Animation | undefined;

      const updatePill = (el: HTMLElement) => {
        const containerRect = container.getBoundingClientRect();
        const linkRect = el.getBoundingClientRect();
        const previous = pill.getBoundingClientRect();
        const visible = Number(getComputedStyle(pill).opacity) > 0;
        const x = linkRect.left - containerRect.left;
        const y = linkRect.top - containerRect.top;
        const transform = `translate(${x}px, ${y}px)`;

        movement?.cancel();

        pill.style.width = `${linkRect.width}px`;
        pill.style.height = `${linkRect.height}px`;
        pill.style.transform = transform;
        pill.style.opacity = '1';

        if (
          visible &&
          previous.width > 0 &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          movement = pill.animate(
            [
              {
                transform: `translate(${previous.left - containerRect.left}px, ${previous.top - containerRect.top}px) scale(${previous.width / linkRect.width}, ${previous.height / linkRect.height})`,
              },
              { transform },
            ],
            { duration: 200, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' }
          );
        }
      };

      const hidePill = () => {
        pill.style.opacity = '0';
      };

      links.forEach((link) => {
        link.addEventListener('mouseenter', () => updatePill(link as HTMLElement));
      });

      container.addEventListener('mouseleave', hidePill);
    }
  }

  // Initialize on page load
  initNavPillEffect();

  // Re-initialize after View Transitions navigation
  document.addEventListener('astro:after-swap', initNavPillEffect);
</script>
