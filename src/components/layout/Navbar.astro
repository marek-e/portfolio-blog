---
import { ModeToggle } from '@/components/layout/ModeToggle';
import { MobileMenu } from '@/components/layout/MobileMenu';
import { Icon } from '@/components/shared/Icon';
import AnimatedLogo from '@/components/layout/AnimatedLogo.astro';
import { getNavLinks } from '@/lib/navigation';
import { getLangFromUrl, getTranslatedPath, getTranslations } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
const translatePath = getTranslatedPath(lang);
const navLinks = getNavLinks(lang);
const t = getTranslations(lang);
const currentPath = Astro.url.pathname;

const linksClasses =
  'text-foreground/75 hover:text-foreground flex items-center gap-2 relative z-10 rounded-full px-3.5 py-2 text-sm font-medium transition-colors';
---

<nav class="fixed top-6 left-1/2 z-50 w-fit -translate-x-1/2">
  <div
    class="glass relative flex items-center gap-5 rounded-full py-2 pr-2 pl-4 before:pointer-events-none before:absolute before:inset-0 before:rounded-full before:bg-linear-to-b before:from-white/40 before:via-transparent before:to-transparent dark:before:from-white/8"
  >
    <a
      href={translatePath('/')}
      aria-label={t.aria.homeLink}
      class="text-foreground group/logo flex items-center gap-2 font-semibold transition-all duration-300 ease-in-out hover:opacity-80 motion-reduce:hover:underline"
    >
      <AnimatedLogo class="size-8" />
    </a>

    <div id="nav-links" class="relative hidden items-center gap-1 md:flex">
      <div
        id="nav-pill"
        class="bg-pastel pointer-events-none absolute rounded-full opacity-0 shadow-[inset_0_1px_0_oklch(1_0_0/60%)] transition-all duration-200 ease-out"
      >
      </div>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class={linksClasses}
            data-nav-link
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <Icon icon={link.icon} strokeWidth={2} className="size-4" />
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <MobileMenu client:load lang={lang} currentPath={currentPath} />
      <ModeToggle client:load />
    </div>
  </div>
</nav>

<script>
  function initNavPillEffect() {
    const container = document.getElementById('nav-links');
    const pill = document.getElementById('nav-pill');
    const links = document.querySelectorAll('[data-nav-link]');

    if (container && pill) {
      const updatePill = (el: HTMLElement) => {
        const containerRect = container.getBoundingClientRect();
        const linkRect = el.getBoundingClientRect();

        pill.style.width = `${linkRect.width}px`;
        pill.style.height = `${linkRect.height}px`;
        pill.style.left = `${linkRect.left - containerRect.left}px`;
        pill.style.top = `${linkRect.top - containerRect.top}px`;
        pill.style.opacity = document.documentElement.classList.contains('dark') ? '0.55' : '0.9';
      };

      const hidePill = () => {
        pill.style.opacity = '0';
      };

      links.forEach((link) => {
        link.addEventListener('mouseenter', () => updatePill(link as HTMLElement));
      });

      container.addEventListener('mouseleave', hidePill);
    }
  }

  // Initialize on page load
  initNavPillEffect();

  // Re-initialize after View Transitions navigation
  document.addEventListener('astro:after-swap', initNavPillEffect);
</script>
