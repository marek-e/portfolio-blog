---
import { ArrowUp04Icon, RssIcon } from '@hugeicons/core-free-icons';
import { Icon } from '../shared/Icon';
import { SOCIALS } from '@/lib/socials';
import { PRESENTATIONS_URL } from '@/lib/sites';
import { getTranslations, getLangFromUrl, getTranslatedPath } from '@/i18n';
import { GlassThemeSwitch } from './GlassThemeSwitch';
import logo from '@/assets/logo.svg';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);
const currentYear = new Date().getFullYear();

const groups = [
  {
    title: t.footer.explore,
    links: [
      { href: translatePath('/projects'), label: t.footer.projects },
      { href: translatePath('/blog'), label: t.footer.blog },
      { href: PRESENTATIONS_URL, label: t.footer.presentations, external: true },
    ],
  },
  {
    title: t.footer.about,
    links: [
      { href: translatePath('/'), label: t.footer.home },
      { href: translatePath('/curriculum-vitae'), label: t.footer.cv },
      { href: translatePath('/contact'), label: t.footer.contact },
    ],
  },
  {
    title: t.footer.resources,
    links: [
      { href: translatePath('/design-system'), label: t.footer.designSystem },
      { href: lang === 'fr' ? '/rss.xml' : '/en/rss.xml', label: 'RSS' },
    ],
  },
];
---

<footer id="footer" class="illustrated-footer text-foreground overflow-clip">
  <div class="footer-scene relative isolate min-h-screen">
    <div class="footer-art-viewport pointer-events-none absolute -z-10 h-screen" aria-hidden="true">
      <div class="footer-art">
        <div class="footer-art-day"></div>
      </div>
    </div>
    <div
      class="footer-content relative mx-auto grid gap-6 pt-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] md:gap-8 md:gap-[clamp(2rem,6vw,7rem)] md:pt-[clamp(3rem,4.5vw,5rem)]"
    >
      <div class="min-w-0">
        <a
          href={translatePath('/')}
          class="footer-identity flex w-fit items-center gap-3 md:flex-col md:items-start md:gap-4"
        >
          <img
            src={logo.src}
            alt=""
            width="67"
            height="48"
            class="h-8 w-auto md:h-12"
            loading="lazy"
            data-footer-logo
          />
          <span
            class="font-display-wonk text-[clamp(2rem,3vw,3rem)] leading-[1.15] font-semibold tracking-[-0.04em]"
            >Marek Elmayan</span
          >
        </a>
        <p class="text-muted-foreground mt-3 hidden font-sans text-xs leading-relaxed md:block">
          AI Engineer · Full-Stack Developer
        </p>
        <p
          class="text-muted-foreground mt-4 hidden max-w-104 text-[0.9375rem] leading-relaxed text-pretty md:block"
        >
          {t.hero.subtitle.split('\n')[0]}
        </p>
        <div class="mt-4 -ml-3 hidden gap-1 md:flex">
          {
            SOCIALS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t.aria.followOn.replace('{platform}', social.name)}
                class="hover:text-primary motion-safe:hover:animate-wiggle grid size-11 place-items-center rounded-full"
              >
                <Icon icon={social.icon} strokeWidth={1.7} className="size-5" />
              </a>
            ))
          }
          <a
            href={lang === 'fr' ? '/rss.xml' : '/en/rss.xml'}
            aria-label={t.aria.subscribeRss}
            class="hover:text-primary motion-safe:hover:animate-wiggle grid size-11 place-items-center rounded-full"
          >
            <Icon icon={RssIcon} strokeWidth={1.7} className="size-5" />
          </a>
        </div>
      </div>
      <nav
        class="grid grid-cols-2 gap-x-4 gap-y-5 md:grid-cols-3 md:gap-6 md:pt-3"
        aria-label={t.footer.sitemap}
      >
        {
          groups.map((group) => (
            <div
              class:list={[
                'min-w-0',
                group.title === t.footer.resources && 'col-span-2 md:col-span-1',
              ]}
            >
              <h2 class="font-sans text-[0.9375rem] leading-normal font-semibold tracking-normal">
                {group.title}
              </h2>
              <ul
                class:list={[
                  'mt-2 grid md:mt-5',
                  group.title === t.footer.resources &&
                    'grid-cols-2 gap-x-4 md:grid-cols-1 md:gap-x-0',
                ]}
              >
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      data-footer-link
                      class="text-muted-foreground hover:bg-primary/10 hover:text-foreground focus-visible:bg-primary/10 focus-visible:text-foreground -ml-3 flex min-h-11 w-fit min-w-11 items-center rounded-full px-3 py-2 text-[0.9375rem] leading-normal font-normal transition-colors duration-150 motion-reduce:transition-none"
                      {...('external' in link
                        ? { target: '_blank', rel: 'noopener noreferrer' }
                        : {})}
                    >
                      <span data-footer-label>{link.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div class="footer-utilities relative mx-auto mt-auto">
      <p class="footer-copyright font-sans text-xs leading-relaxed">
        <span>© {currentYear} Marek Elmayan</span>
        <span class="hidden md:inline" aria-hidden="true"> · </span>
        <span class="block md:inline">{t.footer.exploration}</span>
      </p>
      <GlassThemeSwitch lang={lang} client:visible />
      <button
        type="button"
        data-back-to-top
        class="footer-back-to-top hover:bg-primary/10 focus-visible:bg-primary/10 inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-full px-3 text-[0.8125rem] opacity-80 transition-[background-color,opacity] duration-150 hover:opacity-100 focus-visible:opacity-100 motion-reduce:transition-none md:-mr-3"
      >
        {t.footer.backToTop}
        <Icon icon={ArrowUp04Icon} strokeWidth={1.7} className="size-4" />
      </button>
    </div>
  </div>
</footer>

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || !event.target.closest('[data-back-to-top]')) return;

    window.scrollTo({
      top: 0,
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ? 'instant'
        : 'smooth',
    });
  });
</script>

<style>
  .illustrated-footer {
    --footer-art: url('/images/footer-day-v1.webp');
  }

  :global(.dark) .illustrated-footer {
    --footer-art: url('/images/footer-night-v1.webp');
  }

  .footer-scene {
    display: flex;
    flex-direction: column;
  }

  .footer-scene::after {
    position: absolute;
    z-index: -1;
    inset: auto 0 0;
    height: 12rem;
    background: linear-gradient(transparent, oklch(0.12 0.02 295 / 65%));
    content: '';
    pointer-events: none;
  }

  .footer-art-viewport {
    inset: auto 0 0;
  }

  .footer-art {
    position: absolute;
    inset: 0;
    background: var(--footer-art) center bottom / cover no-repeat;
    mask-image: linear-gradient(
      to bottom,
      transparent 6%,
      rgb(0 0 0 / 4%) 16%,
      rgb(0 0 0 / 16%) 26%,
      rgb(0 0 0 / 42%) 38%,
      rgb(0 0 0 / 74%) 50%,
      rgb(0 0 0 / 94%) 60%,
      black 68%
    );
  }

  .footer-art-day {
    position: absolute;
    inset: 0;
    background: url('/images/footer-day-v1.webp') center bottom / cover no-repeat;
    opacity: 0;
  }

  .footer-scene[data-theme-preview] .footer-art {
    background-image: url('/images/footer-night-v1.webp');
  }

  .footer-content {
    padding-bottom: 16rem;
  }

  .footer-content,
  .footer-utilities {
    width: min(100% - 4rem, 80rem);
  }

  .footer-utilities {
    display: grid;
    grid-template-areas: 'copyright theme top';
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    padding-block: 2rem 1.25rem;
    color: oklch(0.99 0.005 300);
    text-shadow: 0 1px 6px oklch(0.12 0.02 295 / 65%);
  }

  .footer-copyright {
    grid-area: copyright;
    justify-self: start;
  }

  .footer-utilities :global(.theme-glass) {
    grid-area: theme;
    justify-self: center;
  }

  .footer-back-to-top {
    grid-area: top;
    justify-self: end;
  }

  .illustrated-footer a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
  }

  @media (max-width: 767px) {
    .footer-utilities {
      grid-template-areas: 'theme' 'top' 'copyright';
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
      padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
    }

    .footer-copyright,
    .footer-back-to-top {
      justify-self: center;
    }

    .footer-content,
    .footer-utilities {
      width: min(100% - 3rem, 36rem);
    }

    .footer-content {
      padding-bottom: 14rem;
    }

    .footer-art-day {
      background-position: 58% bottom;
    }

    .footer-art {
      background-position: 58% bottom;
      mask-image: linear-gradient(
        to bottom,
        transparent 6%,
        rgb(0 0 0 / 4%) 24%,
        rgb(0 0 0 / 16%) 44%,
        rgb(0 0 0 / 42%) 48%,
        rgb(0 0 0 / 82%) 54%,
        black 64%
      );
    }
  }
</style>
