---
import { getTranslations, getLangFromUrl, getTranslatedPath } from '@/i18n';
import { PRESENTATIONS_URL } from '@/lib/sites';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);
const links = [
  { href: '/projects', label: t.footer.projects },
  { href: '/blog', label: t.footer.blog },
  { href: '/contact', label: t.footer.contact },
  { href: '/curriculum-vitae', label: t.footer.cv },
  { href: '/design-system', label: t.footer.designSystem },
];
---

<footer id="footer" class="site-footer">
  <div class="section-shell">
    <div class="footer-top">
      <a href={translatePath('/')} class="wordmark" aria-label={t.aria.homeLink}
        ><span class="brand-spark" aria-hidden="true">✧</span><span
          >marek<span class="text-primary">.</span></span
        ></a
      ><nav class="footer-links" aria-label={t.footer.sitemap}>
        {links.map((link) => <a href={translatePath(link.href)}>{link.label}</a>)}<a
          href={PRESENTATIONS_URL}
          target="_blank"
          rel="noopener noreferrer">{t.footer.presentations} ↗︎</a
        ><a href={lang === 'fr' ? '/rss.xml' : '/en/rss.xml'}>RSS</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Marek Elmayan</p><p>
        {
          lang === 'fr'
            ? 'Conçu avec soin, construit avec curiosité.'
            : 'Designed with care, built with curiosity.'
        }
      </p><a href="#main-content" class="text-link">{t.footer.backToTop} ↑</a>
    </div>
  </div>
</footer>
