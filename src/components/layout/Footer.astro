---
import { ArrowUp04Icon, RssIcon } from '@hugeicons/core-free-icons';
import { Icon } from '../shared/Icon';
import { SOCIALS } from '@/lib/socials';
import { PRESENTATIONS_URL } from '@/lib/sites';
import { getTranslations, getLangFromUrl, getTranslatedPath } from '@/i18n';
import { LanguageSwitcher } from './LanguageSwitcher';
import { Image } from 'astro:assets';
import logo from '@/assets/logo.svg';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);
const currentPath = Astro.url.pathname;

const currentYear = new Date().getFullYear();

const sitemapLinks = [
  { href: '/', label: t.footer.home },
  { href: '/projects', label: t.footer.projects },
  { href: '/blog', label: t.footer.blog },
  { href: '/design-system', label: t.footer.designSystem },
  { href: '/contact', label: t.footer.contact },
  { href: '/curriculum-vitae', label: t.footer.cv },
  { href: PRESENTATIONS_URL, label: t.footer.presentations, external: true },
];
---

<footer id="footer" class="mx-auto max-w-6xl px-4 pb-6 sm:px-6 lg:px-8">
  <div class="glass text-foreground rounded-[2rem] px-6 py-8 md:px-10 md:py-10">
    <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-start">
      <div class="flex flex-col gap-6">
        <a
          href={translatePath('/')}
          aria-label={t.aria.homeLink}
          class="flex w-fit items-center gap-3 transition-opacity hover:opacity-80"
        >
          <Image src={logo} alt="logo - ME" fetchpriority="low" class="size-10" />
          <span class="font-display-soft text-xl font-semibold tracking-tight">Marek Elmayan</span>
        </a>
        <ul class="flex items-center gap-2">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={t.aria.followOn.replace('{platform}', social.name)}
                  class="glass text-foreground/70 hover:text-foreground flex size-11 items-center justify-center rounded-full transition duration-300 hover:-translate-y-0.5"
                >
                  <Icon icon={social.icon} strokeWidth={2} className="size-4.5" />
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={lang === 'fr' ? '/rss.xml' : '/en/rss.xml'}
              aria-label={t.aria.subscribeRss}
              class="glass text-foreground/70 hover:text-foreground flex size-11 items-center justify-center rounded-full transition duration-300 hover:-translate-y-0.5"
            >
              <Icon icon={RssIcon} strokeWidth={2} className="size-4.5" />
            </a>
          </li>
        </ul>
      </div>

      <nav aria-label={t.footer.sitemap}>
        <p class="eyebrow mb-3">{t.footer.sitemap}</p>
        <ul class="grid grid-cols-2 gap-x-10 sm:grid-cols-3">
          {
            sitemapLinks.map((link) => (
              <li>
                <a
                  href={link.external ? link.href : translatePath(link.href)}
                  class="text-foreground/70 hover:text-foreground inline-flex min-h-10 items-center text-sm transition-colors"
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class="border-foreground/8 mt-10 flex flex-col-reverse items-center justify-between gap-4 border-t pt-6 sm:flex-row"
    >
      <p class="text-muted-foreground font-mono text-xs">© {currentYear} Marek Elmayan</p>

      <div class="flex items-center gap-3">
        <LanguageSwitcher client:load currentLang={lang} currentPath={currentPath} />
        <a
          href="#"
          class="text-muted-foreground hover:text-foreground inline-flex min-h-11 items-center gap-1.5 rounded-full px-3 font-mono text-xs transition-colors"
        >
          {t.footer.backToTop}
          <Icon icon={ArrowUp04Icon} strokeWidth={2} className="size-3.5" />
        </a>
      </div>
    </div>
  </div>
</footer>
