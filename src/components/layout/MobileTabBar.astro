---
import { Home01Icon } from '@hugeicons/core-free-icons';
import { Icon } from '@/components/shared/Icon';
import { getNavLinks } from '@/lib/navigation';
import { PRESENTATIONS_URL } from '@/lib/sites';
import { getLangFromUrl, getTranslatedPath, getTranslations } from '@/i18n';
import { cn } from '@/lib/utils';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);
const homePath = translatePath('/');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const tabs = [
  { href: homePath, label: t.nav.home, icon: Home01Icon, external: false },
  ...getNavLinks(lang).map((link) => ({
    ...link,
    label: link.href === PRESENTATIONS_URL ? t.nav.presentationsShort : link.label,
    external: link.external ?? false,
  })),
];

const normalize = (path: string) => path.replace(/\/$/, '') || '/';

const isActive = (href: string, external: boolean) => {
  if (external) return false;
  const target = normalize(href);
  if (target === normalize(homePath)) return currentPath === target;
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<nav
  aria-label={t.aria.mainNavigation}
  class="mobile-tab-bar fixed inset-x-3 z-50 md:hidden"
  data-mobile-tab-bar
>
  <ul
    class="relative flex items-stretch justify-between gap-1 rounded-full border border-black/15 bg-white/55 p-1.5 shadow-xl shadow-black/10 backdrop-blur-xl backdrop-saturate-150 before:pointer-events-none before:absolute before:inset-0 before:rounded-full before:bg-linear-to-b before:from-white/50 before:via-transparent before:to-transparent dark:border-white/15 dark:bg-black/45 dark:shadow-black/50 dark:before:from-white/10"
  >
    {
      tabs.map((tab) => {
        const active = isActive(tab.href, tab.external);
        return (
          <li class="relative flex-1">
            <a
              href={tab.href}
              aria-current={active ? 'page' : undefined}
              class={cn(
                'flex min-h-14 flex-col items-center justify-center gap-1 rounded-full px-1 text-[0.68rem] font-medium transition-all duration-200 active:scale-95',
                active
                  ? 'text-foreground bg-white/80 shadow-[inset_0_1px_0_oklch(1_0_0/90%),0_4px_12px_-4px_oklch(0_0_0/25%)] dark:bg-white/15 dark:shadow-[inset_0_1px_0_oklch(1_0_0/20%)]'
                  : 'text-foreground/70 hover:text-foreground'
              )}
              {...(tab.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <Icon
                icon={tab.icon}
                strokeWidth={active ? 2.2 : 1.8}
                className={cn('size-5', active && 'text-primary')}
              />
              <span class="leading-none">{tab.label}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .mobile-tab-bar {
    bottom: max(0.75rem, env(safe-area-inset-bottom));
  }
</style>
