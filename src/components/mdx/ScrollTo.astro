---
import { ArrowDown02Icon, ArrowUp02Icon } from '@hugeicons/core-free-icons';
import { Icon } from '@/components/shared/Icon';
import { getLangFromUrl, getTranslations } from '@/i18n';

interface Props {
  to: string;
  label: string;
  direction?: 'up' | 'down';
}

const { to, label, direction = 'up' } = Astro.props;
const t = getTranslations(getLangFromUrl(Astro.url));
---

<script>
  const stillness = window.matchMedia('(prefers-reduced-motion: reduce)');
  const GAP = 8;
  let portal: HTMLButtonElement | null = null;
  let place: (() => void) | null = null;

  const behavior = (): ScrollBehavior => (stillness.matches ? 'instant' : 'smooth');
  const pageTop = (element: Element) => element.getBoundingClientRect().top + window.scrollY;

  const close = () => {
    portal?.remove();
    portal = null;
    if (place) window.removeEventListener('resize', place);
    place = null;
  };

  const open = (link: HTMLAnchorElement, target: HTMLElement, linkOffset: number) => {
    close();
    const button = document.createElement('button');
    const arrow = document.createElement('span');
    button.type = 'button';
    button.className =
      'border-primary/40 bg-card text-primary shadow-primary/20 hover:bg-primary/10 focus-visible:ring-ring/50 absolute z-40 inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-xs shadow-lg transition-colors outline-none focus-visible:ring-[3px]';
    arrow.setAttribute('aria-hidden', 'true');
    arrow.textContent = pageTop(link) > pageTop(target) ? '↓' : '↑';
    button.append(arrow, link.dataset.scrollBack ?? '');

    place = () => {
      const box = target.getBoundingClientRect();
      const above = box.top + window.scrollY - button.offsetHeight - GAP;
      button.style.top = `${above < 0 ? box.top + window.scrollY + GAP : above}px`;
      button.style.left = `${Math.max(box.left, box.right - button.offsetWidth) + window.scrollX}px`;
    };

    button.addEventListener('click', () => {
      const top = pageTop(link) - linkOffset;
      close();
      window.scrollTo({ top, behavior: behavior() });
      history.replaceState(null, '', location.pathname + location.search);
      link.focus({ preventScroll: true });
    });

    document.body.append(button);
    place();
    window.addEventListener('resize', place);
    portal = button;
    if (!stillness.matches) {
      button.animate(
        [
          { opacity: 0, transform: 'translateY(6px) scale(0.94)' },
          { opacity: 1, transform: 'none' },
        ],
        { duration: 240, delay: 300, easing: 'ease-out', fill: 'backwards' }
      );
    }
    button.focus({ preventScroll: true });
    return button;
  };

  document.addEventListener(
    'click',
    (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
        return;
      const link =
        event.target instanceof Element ? event.target.closest('a[data-scroll-to]') : null;
      if (!(link instanceof HTMLAnchorElement)) return;
      const target = document.getElementById(link.dataset.scrollTo ?? '');
      if (!target) return;
      event.preventDefault();
      const linkOffset = link.getBoundingClientRect().top;
      const pill = open(link, target, linkOffset);
      const clearance = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
      const safe = clearance + pill.offsetHeight + GAP * 2;
      const centered = (window.innerHeight - target.getBoundingClientRect().height) / 2;
      window.scrollTo({ top: pageTop(target) - Math.max(safe, centered), behavior: behavior() });
      history.pushState(null, '', `#${target.id}`);
    },
    { capture: true }
  );

  document.addEventListener('astro:before-swap', close);
</script>

<span class="whitespace-nowrap"
  ><slot /><a
    href={`#${to}`}
    data-scroll-to={to}
    data-scroll-back={t.blog.scrollBack}
    aria-label={label}
    title={label}
    class="not-prose text-primary hover:bg-primary/10 focus-visible:ring-ring/50 relative -top-[0.5em] ml-0.5 inline-flex size-3.5 items-center justify-center rounded-sm align-baseline transition-colors outline-none focus-visible:ring-[3px]"
    ><Icon
      icon={direction === 'up' ? ArrowUp02Icon : ArrowDown02Icon}
      strokeWidth={2.5}
      className="size-3.5"
    /></a
  ></span
>
