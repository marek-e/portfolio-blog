---
interface Props {
  to: string;
  label: string;
  direction?: 'up' | 'down';
}

const { to, label, direction = 'up' } = Astro.props;
---

<script>
  const stillness = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.addEventListener(
    'click',
    (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
        return;
      const link =
        event.target instanceof Element ? event.target.closest('a[data-scroll-to]') : null;
      if (!(link instanceof HTMLAnchorElement)) return;
      const target = document.getElementById(link.dataset.scrollTo ?? '');
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({
        behavior: stillness.matches ? 'instant' : 'smooth',
        block: 'center',
      });
      history.pushState(null, '', `#${target.id}`);
    },
    { capture: true }
  );
</script>

<a
  href={`#${to}`}
  data-scroll-to={to}
  aria-label={label}
  title={label}
  class="not-prose text-primary hover:bg-primary/10 focus-visible:ring-ring/50 rounded-sm px-0.5 font-bold no-underline transition-colors outline-none focus-visible:ring-[3px]"
  ><span aria-hidden="true">{direction === 'up' ? '↑' : '↓'}</span></a
>
