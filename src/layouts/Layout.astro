---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { getAlternatePath, getLangFromUrl } from '@/i18n/config';
import '../styles/rebrand.css';
import '../styles/materials.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, image, imageAlt } = Astro.props;

// Social platforms read this out to screen-reader users in place of the card.
// The title is the card's dominant content, so it is the right fallback.
const socialImageAlt = imageAlt || title;

const lang = getLangFromUrl(Astro.url);

// The site-level card is generated per locale, so a French page doesn't unfurl
// with English copy. Scrapers need an absolute URL, so resolve it against the
// site: pages that pass an absolute URL of their own are left untouched.
const socialImage = new URL(
  image ?? (lang === 'en' ? '/en/og-image.jpg' : '/og-image.jpg'),
  Astro.site
).toString();

const currentPath = Astro.url.pathname;
const isNotFound = currentPath.startsWith('/404');
const canonicalURL = new URL(currentPath, Astro.site);

// Generate alternate URLs for hreflang tags
const frPath = getAlternatePath(currentPath, lang, 'fr');
const enPath = getAlternatePath(currentPath, lang, 'en');
const frURL = new URL(frPath, Astro.site);
const enURL = new URL(enPath, Astro.site);
---

<!doctype html>
<html lang={lang} data-type="software" data-motion="live" data-radius="soft" data-buttons="pill">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon-rebrand.svg" />
    <link rel="icon" type="image/png" href="/brand-icon-96.png" sizes="96x96" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Alternate language links for SEO -->
    {
      isNotFound ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="alternate" hreflang="fr" href={frURL} />
          <link rel="alternate" hreflang="en" href={enURL} />
          <link rel="alternate" hreflang="x-default" href={frURL} />
        </>
      )
    }

    <!-- RSS Feed Discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={lang === 'fr' ? 'Blog - Marek Elmayan (Français)' : 'Blog - Marek Elmayan (English)'}
      href={lang === 'fr' ? '/rss.xml' : '/en/rss.xml'}
    />

    <meta name="generator" content={Astro.generator} />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />
    <meta name="theme-color" content="#fbf6ee" />
    <link rel="stylesheet" href="/assets/motion/motion.css" />
    <script is:inline>
      document.documentElement.classList.add('m-enter');
      setTimeout(() => document.documentElement.classList.add('m-enter-done'), 700);
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImage} />
    <meta property="twitter:image:alt" content={socialImageAlt} />

    <meta name="color-scheme" content="light dark" />

    <!-- DNS prefetch for fastest resolution -->
    <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />

    <!-- Preconnect to external origins -->
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />

    <!-- Structured Data for Person -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Marek Elmayan",
        "url": "https://melmayan.fr",
        "image": "https://melmayan.fr/brand-icon-512.png",
        "jobTitle": "Full-Stack Software Engineer",
        "description": "Portfolio et blog de Marek Elmayan, ingénieur logiciel full-stack. Spécialisation en UX, cybersécurité, IA et DevX.",
        "email": "melmayan.dev@gmail.com",
        "sameAs": [
          "https://github.com/marek-e",
          "https://www.linkedin.com/in/marek-elmayan",
          "https://x.com/__mareke__"
        ]
      }
    </script>

    <!-- Structured Data for Website -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Marek Elmayan",
        "url": "https://melmayan.fr",
        "author": {
          "@type": "Person",
          "name": "Marek Elmayan"
        },
        "inLanguage": ["fr", "en"]
      }
    </script>

    <slot name="head" />
    <ClientRouter />
    <script is:inline>
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');

      function applyStoredTheme() {
        let stored = localStorage.getItem('theme');

        if (stored !== null && stored !== 'light' && stored !== 'dark') {
          localStorage.removeItem('theme');
          stored = null;
        }

        const isDark = stored === 'dark' || (stored === null && systemTheme.matches);
        document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
      }

      // Apply theme immediately on page load
      applyStoredTheme();

      // Reapply theme after View Transitions navigation
      document.addEventListener('astro:after-swap', applyStoredTheme);

      // Follow the OS while no override is stored
      systemTheme.addEventListener('change', applyStoredTheme);
    </script>
  </head>
  <body class="bg-background text-foreground min-h-dvh antialiased">
    <a class="skip-link" href="#main-content"
      >{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a
    >
    <slot />
    <script is:inline type="module">
      import * as motion from '/assets/motion/motion.js';
      window.__momentsManual = true;
      const moments = await import('/assets/moments/moments.js');
      let dark = document.documentElement.classList.contains('dark');
      const updateScenes = async () => {
        moments.unmountAll(document);
        const isDark = document.documentElement.classList.contains('dark');
        const images = [...document.querySelectorAll('img[data-studio]')];
        for (const img of images) {
          img.src = isDark ? img.dataset.nightSrc : img.dataset.daySrc;
          img.srcset = isDark ? img.dataset.nightSet : img.dataset.daySet;
        }
        await Promise.all(images.map((img) => img.decode().catch(() => {})));
        await moments.mountAll(document);
      };
      const start = () => {
        motion.refresh();
        updateScenes();
      };
      document.addEventListener('astro:before-swap', () => moments.unmountAll(document));
      document.addEventListener('astro:page-load', start);
      new MutationObserver(() => {
        const next = document.documentElement.classList.contains('dark');
        if (next === dark) return;
        dark = next;
        moments.unmountAll(document);
        updateScenes();
      }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      start();
    </script>
  </body>
</html>
