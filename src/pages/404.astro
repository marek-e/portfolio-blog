---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import { Link } from '@/components/ui/button';
import { getLangFromUrl, getTranslatedPath, getTranslations } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);
---

<Layout title={t.notFound.pageTitle} description={t.notFound.pageDescription}>
  <Navbar />
  <main
    id="main-content"
    class="section-shell grid min-h-dvh items-center gap-8 pt-36 pb-16 md:grid-cols-2"
  >
    <div class="page-heading border-0">
      <p class="eyebrow">404 / {lang === 'fr' ? 'Un détour imprévu' : 'An unexpected detour'}</p>
      <h1>{t.notFound.heading}</h1>
      <p class="text-muted-foreground my-8 max-w-md leading-relaxed">{t.notFound.message}</p>
      <Link href={translatePath('/')} size="lg" className="sculpted-button"
        >{t.notFound.backHome} <span aria-hidden="true">↗︎</span></Link
      >
    </div>
    <img
      src="/melo/melo-explorer.webp"
      alt=""
      width="1000"
      height="1076"
      class="mx-auto w-full max-w-sm"
    />
  </main>
  <Footer />
</Layout>
