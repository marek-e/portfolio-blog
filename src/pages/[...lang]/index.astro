---
import Navbar from '@/components/layout/Navbar.astro';
import Hero from '@/components/portfolio/Hero.astro';
import AboutSection from '@/components/portfolio/AboutSection.astro';
import TimelineSection from '@/components/portfolio/TimelineSection.astro';
import FeaturedProjects from '@/components/portfolio/FeaturedProjects.astro';
import StravaSection from '@/components/portfolio/StravaSection.astro';
import ContactSection from '@/components/portfolio/ContactSection.astro';
import Footer from '@/components/layout/Footer.astro';
import { BackToTop } from '@/components/layout/BackToTop';
import Layout from '@/layouts/Layout.astro';
import { getTranslations, defaultLang } from '@/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // / → French (default)
    { params: { lang: 'en' } as const }, // /en/ → English
  ];
}

const lang = Astro.params.lang ?? defaultLang;
const t = getTranslations(lang);
---

<Layout title={t.hero.pageTitle} description={t.hero.pageDescription}>
  <Navbar />
  <main class="home-sections">
    <Hero />
    <AboutSection />
    <TimelineSection />
    <FeaturedProjects />
    <StravaSection />
    <ContactSection />
  </main>
  <Footer />
  <BackToTop client:load label={t.footer.backToTop} />
</Layout>

<script>
  function initHomeOrder() {
    const main = document.querySelector('.home-sections');
    const projects = main?.querySelector('#projects');
    const about = main?.querySelector('#about');
    const running = main?.querySelector('#running');
    if (!main || !projects || !about || !running) return;

    const mobile = window.matchMedia('(max-width: 767px)');
    const updateOrder = () => main.insertBefore(projects, mobile.matches ? about : running);
    updateOrder();
    mobile.addEventListener('change', updateOrder);
    document.addEventListener(
      'astro:before-swap',
      () => mobile.removeEventListener('change', updateOrder),
      { once: true }
    );
  }

  initHomeOrder();
  document.addEventListener('astro:after-swap', initHomeOrder);
</script>

<style>
  @media (max-width: 767px) {
    .home-sections {
      display: flex;
      flex-direction: column;
    }

    .home-sections > :global(#projects) {
      order: -1;
    }

    .home-sections > :global(:first-child) {
      order: -2;
    }
  }
</style>
