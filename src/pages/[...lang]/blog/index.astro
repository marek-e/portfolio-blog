---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import SectionHeading from '@/components/shared/SectionHeading.astro';
import PostMeta from '@/components/blog/PostMeta.astro';
import PostTags from '@/components/blog/PostTags.astro';
import { Doodle } from '@/components/shared/HandDrawn';
import { getCollection } from 'astro:content';
import { getTranslations, defaultLang } from '@/i18n';
import { getTranslatedPath, languages } from '@/i18n/config';
import { ArrowRight02Icon, RssIcon } from '@hugeicons/core-free-icons';
import { Icon } from '@/components/shared/Icon';
import { getSlug, estimateReadingTime } from '@/lib/blog';
import { cn } from '@/lib/utils';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } as const }];
}

const lang = Astro.params.lang ?? defaultLang;
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => post.id.startsWith(`${lang}/`))
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const [featured, ...rest] = posts;

const cardTones = [
  'border-pastel-sky/70 bg-pastel-sky/15 hover:bg-pastel-sky/30 dark:border-pastel-sky/25 dark:bg-pastel-sky/8 dark:hover:bg-pastel-sky/14',
  'border-pastel-mint/80 bg-pastel-mint/15 hover:bg-pastel-mint/30 dark:border-pastel-mint/25 dark:bg-pastel-mint/8 dark:hover:bg-pastel-mint/14',
  'border-pastel-peach/70 bg-pastel-peach/15 hover:bg-pastel-peach/30 dark:border-pastel-peach/25 dark:bg-pastel-peach/8 dark:hover:bg-pastel-peach/14',
  'border-pastel-rose/70 bg-pastel-rose/15 hover:bg-pastel-rose/30 dark:border-pastel-rose/25 dark:bg-pastel-rose/8 dark:hover:bg-pastel-rose/14',
  'border-pastel-butter/90 bg-pastel-butter/20 hover:bg-pastel-butter/35 dark:border-pastel-butter/25 dark:bg-pastel-butter/8 dark:hover:bg-pastel-butter/14',
];
---

<Layout
  title={t.blog.pageTitle}
  description={t.blog.pageDescription}
  image={lang === 'en' ? '/en/og-image_blog.jpg' : '/og-image_blog.jpg'}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: t.blog.pageTitle,
      url: Astro.url.href,
      description: t.blog.pageDescription,
      author: {
        '@type': 'Person',
        name: 'Marek Elmayan',
      },
      inLanguage: Object.keys(languages),
    })}
  />
  <Navbar />
  <main class="mx-auto min-h-dvh w-full max-w-6xl px-4 pt-36 pb-24 md:pt-44 md:pb-32">
    <SectionHeading
      as="h1"
      eyebrow={t.blog.eyebrow}
      title={t.blog.title}
      subtitle={t.blog.subtitle}
    >
      <a
        href={lang === 'fr' ? '/rss.xml' : '/en/rss.xml'}
        aria-label={t.aria.subscribeRss}
        class="group border-border text-muted-foreground hover:text-primary inline-flex shrink-0 items-center gap-2 self-start rounded-md border px-3 py-1.5 font-mono text-xs transition-colors hover:border-current md:self-auto"
      >
        <Icon
          icon={RssIcon}
          strokeWidth={2}
          className="motion-safe:group-hover:animate-wiggle size-4 transition-transform duration-300"
        />
        RSS
      </a>
    </SectionHeading>

    {
      posts.length === 0 ? (
        <p class="bg-card text-muted-foreground mt-16 rounded-3xl border p-12 text-center shadow-sm">
          {t.blog.noPosts}
        </p>
      ) : (
        <div class="mt-14 space-y-6 md:mt-20 md:space-y-7">
          {featured && (
            <a
              href={translatePath(`/blog/${getSlug(featured.id, lang)}`)}
              class="group bg-card border-pastel-lilac dark:border-pastel-lilac/30 relative block rounded-3xl border p-6 shadow-[6px_6px_0_var(--color-pastel-lilac)] transition duration-300 hover:-translate-y-0.5 hover:shadow-[8px_8px_0_var(--color-pastel-lilac)] sm:p-8 md:p-12 dark:shadow-[6px_6px_0_color-mix(in_oklab,var(--color-pastel-lilac)_25%,transparent)] dark:hover:shadow-[8px_8px_0_color-mix(in_oklab,var(--color-pastel-lilac)_30%,transparent)]"
            >
              <Doodle
                name="sparkle"
                className="text-pastel-lilac absolute top-8 right-8 hidden size-7 rotate-12 md:block"
              />
              <Doodle
                name="sparkle"
                className="text-pastel-peach absolute top-16 right-16 hidden size-4 -rotate-12 md:block"
              />
              <article class="flex flex-col gap-6">
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                  <span class="bg-pastel-rose/60 text-foreground/85 dark:bg-pastel-rose/12 dark:text-pastel-rose rounded-full px-3 py-1 font-mono text-xs">
                    {t.blog.latest}
                  </span>
                  <PostMeta
                    date={featured.data.publishDate}
                    lang={lang}
                    readingTime={estimateReadingTime(featured.body ?? '')}
                    minRead={t.blog.minRead}
                  />
                </div>
                <h2 class="font-display-soft max-w-4xl text-3xl leading-[1.08] font-semibold tracking-tight text-balance md:text-5xl">
                  {featured.data.title}
                </h2>
                <p class="text-muted-foreground max-w-2xl text-lg leading-relaxed text-pretty">
                  {featured.data.description}
                </p>
                <div class="flex flex-wrap items-center justify-between gap-4 pt-2">
                  <PostTags tags={featured.data.tags} />
                  <span class="text-foreground inline-flex items-center gap-2 text-sm font-medium">
                    {t.blog.readMore}
                    <Icon
                      icon={ArrowRight02Icon}
                      strokeWidth={2}
                      className="size-4 transition-transform duration-300 group-hover:translate-x-1"
                    />
                  </span>
                </div>
              </article>
            </a>
          )}

          {rest.length > 0 && (
            <ul class="space-y-4 md:space-y-5">
              {rest.map((post, index) => (
                <li>
                  <a
                    href={translatePath(`/blog/${getSlug(post.id, lang)}`)}
                    class={cn(
                      'group block rounded-3xl border p-6 transition duration-300 hover:-translate-y-0.5 md:p-8',
                      cardTones[index % cardTones.length]
                    )}
                  >
                    <article class="grid gap-x-10 gap-y-3 md:grid-cols-[11rem_1fr_auto]">
                      <PostMeta
                        date={post.data.publishDate}
                        lang={lang}
                        readingTime={estimateReadingTime(post.body ?? '')}
                        minRead={t.blog.minRead}
                        stacked
                      />
                      <div class="flex min-w-0 flex-col gap-3">
                        <h2 class="font-display-soft text-xl leading-snug font-semibold tracking-tight text-balance md:text-2xl">
                          {post.data.title}
                        </h2>
                        <p class="text-muted-foreground line-clamp-2 leading-relaxed">
                          {post.data.description}
                        </p>
                        <PostTags tags={post.data.tags} class="pt-1" />
                      </div>
                      <span
                        aria-hidden="true"
                        class="bg-card text-muted-foreground group-hover:text-foreground hidden size-11 items-center justify-center self-center rounded-full border transition duration-300 group-hover:translate-x-1 md:flex"
                      >
                        <Icon icon={ArrowRight02Icon} strokeWidth={2} className="size-4" />
                      </span>
                    </article>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }
  </main>
  <Footer />
</Layout>
