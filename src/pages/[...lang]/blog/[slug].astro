---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import PostMeta from '@/components/blog/PostMeta.astro';
import PostTags from '@/components/blog/PostTags.astro';
import { Doodle } from '@/components/shared/HandDrawn';
import {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import { render } from 'astro:content';
import { getTranslations, defaultLang } from '@/i18n';
import { getTranslatedPath } from '@/i18n/config';
import { mdxComponents } from '@/components/mdx';
import Toggle from '@/components/mdx/Toggle.astro';
import CodeToggle from '@/components/mdx/CodeToggle.astro';
import { formatDate, estimateReadingTime } from '@/lib/blog';
import { Icon } from '@/components/shared/Icon';
import { ArrowLeft02Icon, HomeIcon, Link02Icon, RssIcon } from '@hugeicons/core-free-icons';
import { Link } from '@/components/ui/button';
import { PostActionsMenu } from '@/components/blog/PostActionsMenu';
import { getBlogPostRoutes, type BlogPost } from '@/lib/blog-routes';

export async function getStaticPaths() {
  return getBlogPostRoutes();
}

type Props = {
  post: BlogPost;
};

const { post } = Astro.props;

const lang = Astro.params.lang ?? defaultLang;
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);

const { Content } = await render(post);

const readingTime = estimateReadingTime(post.body ?? '');
const slug = post.id.split('/').pop();
const rssUrl = lang === 'fr' ? '/rss.xml' : '/en/rss.xml';
---

<Layout
  title={`${post.data.title} | ${t.blog.title}`}
  description={post.data.description}
  image={new URL(`${Astro.url.pathname.replace(/\/$/, '')}/og.jpg`, Astro.site).toString()}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      author: {
        '@type': 'Person',
        name: 'Marek Elmayan',
        url: 'https://melmayan.fr',
      },
      datePublished: post.data.publishDate.toISOString(),
      dateModified: (post.data.updatedDate || post.data.publishDate).toISOString(),
      url: Astro.url.href,
      inLanguage: lang,
      keywords: post.data.tags.join(', '),
      timeRequired: `PT${readingTime}M`,
    })}
  />
  <Navbar />
  <main class="mx-auto w-full max-w-6xl px-4 pt-32 pb-24 md:pt-40 md:pb-32">
    <div class="mx-auto max-w-3xl">
      <div class="flex items-center justify-between gap-4">
        <Breadcrumb className="min-w-0">
          <BreadcrumbList className="flex-nowrap">
            <BreadcrumbItem>
              <BreadcrumbLink href={translatePath('/')} aria-label="Home">
                <Icon
                  icon={HomeIcon}
                  strokeWidth={2}
                  className="motion-safe:hover:animate-wiggle size-4 transition-transform duration-300 ease-in-out"
                />
              </BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbLink href={translatePath('/blog')}>{t.blog.title}</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem className="min-w-0">
              <BreadcrumbPage className="block truncate">{post.data.title}</BreadcrumbPage>
            </BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>
        {
          post.data.copyMarkdown ? (
            <PostActionsMenu
              copyUrl={translatePath(`/blog/${slug}.md`)}
              rssUrl={rssUrl}
              triggerLabel={t.aria.postActions}
              copyLabel={t.blog.copyMarkdown}
              copiedLabel={t.blog.copied}
              rssLabel={t.aria.subscribeRss}
              client:load
            />
          ) : (
            <a
              href={rssUrl}
              aria-label={t.aria.subscribeRss}
              class="group border-border text-muted-foreground hover:text-primary inline-flex shrink-0 items-center gap-2 rounded-md border px-3 py-1.5 font-mono text-xs transition-colors hover:border-current"
            >
              <Icon
                icon={RssIcon}
                strokeWidth={2}
                className="motion-safe:group-hover:animate-wiggle size-4 transition-transform duration-300"
              />
              RSS
            </a>
          )
        }
      </div>

      <article class="mt-14 md:mt-20">
        <header class="flex flex-col gap-6">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <PostMeta
              date={post.data.publishDate}
              lang={lang}
              readingTime={readingTime}
              minRead={t.blog.minRead}
            />
            {
              post.data.updatedDate && (
                <p class="text-muted-foreground font-mono text-xs tracking-wide">
                  <span aria-hidden="true" class="text-foreground/25 mr-3">
                    /
                  </span>
                  {t.blog.updatedOn}{' '}
                  <time datetime={post.data.updatedDate.toISOString()}>
                    {formatDate(post.data.updatedDate, lang)}
                  </time>
                </p>
              )
            }
          </div>

          <h1
            class="group font-display-soft text-foreground text-4xl leading-[1.05] font-semibold tracking-tight text-balance md:text-6xl"
          >
            <a href={translatePath(`/blog/${slug}`)} class="hover:text-primary transition-colors">
              {post.data.title}
            </a>
            <span
              class="text-primary/70 ml-2 inline-flex items-center align-middle opacity-0 transition-opacity group-hover:opacity-100"
            >
              <Icon icon={Link02Icon} strokeWidth={2} className="size-6" />
            </span>
          </h1>

          <p class="text-muted-foreground text-xl leading-relaxed text-pretty">
            {post.data.description}
          </p>

          <PostTags tags={post.data.tags} />
        </header>

        <Doodle name="squiggle" strokeWidth={2.5} className="text-marker my-12 h-4 w-20 md:my-16" />

        <div class="prose prose-neutral dark:prose-invert md:prose-lg max-w-none">
          <Content components={{ ...mdxComponents, Toggle, CodeToggle }} />
        </div>
      </article>

      <div class="border-border mt-16 border-t pt-10 md:mt-24">
        <Link href={translatePath('/blog')} variant="outline" size="lg">
          <Icon icon={ArrowLeft02Icon} strokeWidth={2} className="size-4" />
          {t.blog.backToBlog}
        </Link>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { initCopyButtons } from '@/lib/copy-buttons';
  import { initMermaidDiagrams, setupMermaidThemeObserver } from '@/lib/mermaid-diagrams';

  initCopyButtons();
  initMermaidDiagrams();
  setupMermaidThemeObserver();

  document.addEventListener('astro:after-swap', () => {
    initCopyButtons();
    initMermaidDiagrams();
  });
</script>
