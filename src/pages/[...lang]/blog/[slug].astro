---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import { Badge } from '@/components/ui/badge';
import {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import { getCollection, render } from 'astro:content';
import StudioScene from '@/components/brand/StudioScene.astro';
import CraftObject from '@/components/brand/CraftObject.astro';
import Sketch from '@/components/brand/Sketch.astro';
import { getTranslations, defaultLang } from '@/i18n';
import { getTranslatedPath } from '@/i18n/config';
import { mdxComponents } from '@/components/mdx';
import Toggle from '@/components/mdx/Toggle.astro';
import CodeToggle from '@/components/mdx/CodeToggle.astro';
import { Separator } from '@/components/ui/separator';
import { formatDate, estimateReadingTime, getTagColor } from '@/lib/blog';
import { Icon } from '@/components/shared/Icon';
import { ArrowLeft02Icon, HomeIcon, RssIcon } from '@hugeicons/core-free-icons';
import { Link } from '@/components/ui/button';
import { PostActionsMenu } from '@/components/blog/PostActionsMenu';
import { getBlogPostRoutes, type BlogPost } from '@/lib/blog-routes';

export async function getStaticPaths() {
  return getBlogPostRoutes();
}

type Props = {
  post: BlogPost;
};

const { post } = Astro.props;

const lang = Astro.params.lang ?? defaultLang;
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);

const { Content, headings } = await render(post);
const contents = headings.filter((heading) => heading.depth === 2);
const related = (await getCollection('blog'))
  .filter((entry) => entry.id.startsWith(`${lang}/`) && entry.id !== post.id && !entry.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const readingTime = estimateReadingTime(post.body ?? '');
const slug = post.id.split('/').pop();
const rssUrl = lang === 'fr' ? '/rss.xml' : '/en/rss.xml';
---

<Layout
  title={`${post.data.title} | ${t.blog.title}`}
  description={post.data.description}
  image={new URL(`${Astro.url.pathname.replace(/\/$/, '')}/og.jpg`, Astro.site).toString()}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      author: {
        '@type': 'Person',
        name: 'Marek Elmayan',
        url: 'https://melmayan.fr',
      },
      datePublished: post.data.publishDate.toISOString(),
      dateModified: (post.data.updatedDate || post.data.publishDate).toISOString(),
      url: Astro.url.href,
      inLanguage: lang,
      keywords: post.data.tags.join(', '),
      timeRequired: `PT${readingTime}M`,
    })}
  />
  <Navbar />
  <main id="main-content" class="article-page section-shell pt-32 pb-16">
    <div class="article-breadcrumb mb-6 flex items-center justify-between gap-4">
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink href={translatePath('/')} aria-label="Home">
              <Icon
                icon={HomeIcon}
                strokeWidth={2}
                className="motion-safe:hover:animate-wiggle size-4 transition-transform duration-300 ease-in-out"
              />
            </BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbLink href={translatePath('/blog')}>{t.blog.title}</BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>
              <span class="block max-w-44 truncate font-medium md:max-w-md">
                {post.data.title}
              </span>
            </BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
      {
        post.data.copyMarkdown ? (
          <PostActionsMenu
            copyUrl={translatePath(`/blog/${slug}.md`)}
            rssUrl={rssUrl}
            triggerLabel={t.aria.postActions}
            copyLabel={t.blog.copyMarkdown}
            copiedLabel={t.blog.copied}
            rssLabel={t.aria.subscribeRss}
            client:load
          />
        ) : (
          <a
            href={rssUrl}
            aria-label={t.aria.subscribeRss}
            class="group text-muted-foreground hover:text-primary flex shrink-0 items-center gap-2 rounded-md border border-transparent px-3 py-1.5 text-sm transition-colors hover:border-current"
          >
            <Icon
              icon={RssIcon}
              strokeWidth={2}
              className="group-hover:animate-wiggle size-4 transition-transform duration-300"
            />
            <span class="hidden sm:inline">RSS</span>
          </a>
        )
      }
    </div>

    <header class="article-masthead hero" data-enter>
      <div class="article-heading">
        <div class="text-muted-foreground flex flex-wrap items-center gap-3 text-sm">
          {post.data.tags.slice(0, 1).map((tag) => <Badge variant={getTagColor(tag)}>{tag}</Badge>)}
          <time datetime={post.data.publishDate.toISOString()}
            >{formatDate(post.data.publishDate, lang)}</time
          >
          <span>{readingTime} {t.blog.minRead}</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="article-deck">{post.data.description}</p>
        <div class="article-author">
          <img src="/images/marek-profile-small.webp" width="44" height="44" alt="" /><div>
            <p>Marek Elmayan</p><span
              >{
                lang === 'fr' ? 'Développeur · Curieux par nature' : 'Developer · Curious by nature'
              }</span
            >
          </div>
        </div>
      </div>
      <div class="article-world" data-enter-media>
        <StudioScene compact eager /><span class="handwritten article-note"
          >{lang === 'fr' ? 'Des idées, du code, un café.' : 'Ideas, code, a little coffee.'}</span
        >
      </div>
      <Sketch kind="orbit" class="article-margin-sketch" />
    </header>
    {
      contents.length > 0 && (
        <details class="mobile-contents liquid-glass">
          <>
            <summary>{lang === 'fr' ? 'Dans cet article' : 'On this page'}</summary>
            <nav aria-label={lang === 'fr' ? 'Sommaire' : 'Contents'}>
              <ol>
                {contents.map((heading, index) => (
                  <li>
                    <a href={`#${heading.slug}`}>
                      {index + 1}. {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </>
        </details>
      )
    }
    <div class="article-body-grid">
      <div class="article-reading">
        <div class="prose prose-neutral dark:prose-invert max-w-none">
          <Content components={{ ...mdxComponents, Toggle, CodeToggle }} />
        </div>
        {
          post.data.updatedDate && (
            <p class="text-muted-foreground mt-8 text-sm">
              {t.blog.updatedOn} {formatDate(post.data.updatedDate, lang)}
            </p>
          )
        }
        <Separator className="my-8" />
        <Link href={translatePath('/blog')} variant="link"
          ><Icon icon={ArrowLeft02Icon} strokeWidth={2} className="size-4" />{
            t.blog.backToBlog
          }</Link
        >
      </div>
      <aside
        class="journal-sidebar"
        aria-label={lang === 'fr' ? 'Autour de cet article' : 'Around this article'}
      >
        {
          contents.length > 0 && (
            <nav
              class="sidebar-panel contents-panel liquid-glass"
              aria-labelledby="contents-heading"
            >
              <>
                <h2 id="contents-heading">{lang === 'fr' ? 'Dans cet article' : 'On this page'}</h2>
                <ol>
                  {contents.map((heading, index) => (
                    <li>
                      <a href={`#${heading.slug}`}>
                        <span>{index + 1}.</span>
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </>
            </nav>
          )
        }
        <div class="sidebar-panel companion-panel">
          <img
            src="/melo/melo-welcome.webp"
            srcset="/melo/melo-welcome-small.webp 480w, /melo/melo-welcome.webp 800w"
            sizes="240px"
            width="800"
            height="533"
            alt=""
            loading="lazy"
          /><CraftObject kind="journal" /><h2>
            {lang === 'fr' ? 'Apprendre en construisant.' : 'Learning by building.'}
          </h2><p>
            {
              lang === 'fr'
                ? 'Mes projets, mes essais et ce que j’en retiens.'
                : 'My projects, experiments, and what I learn along the way.'
            }
          </p><a class="text-link" href={translatePath('/projects')}>{t.hero.ctaProjects} ↗︎</a
          ><Sketch kind="botanical" />
        </div>
        {
          related.length > 0 && (
            <div class="sidebar-panel related-panel">
              <h2>{lang === 'fr' ? 'Continuer la lecture' : 'Keep reading'}</h2>
              {related.map((entry) => (
                <a href={translatePath(`/blog/${entry.id.replace(/^(fr|en)\//, '')}`)}>
                  <span class="related-spark" aria-hidden="true">
                    ✧
                  </span>
                  <span>{entry.data.title}</span>
                </a>
              ))}
            </div>
          )
        }
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { initCopyButtons } from '@/lib/copy-buttons';
  import { initMermaidDiagrams, setupMermaidThemeObserver } from '@/lib/mermaid-diagrams';

  initCopyButtons();
  initMermaidDiagrams();
  setupMermaidThemeObserver();

  document.addEventListener('astro:after-swap', () => {
    initCopyButtons();
    initMermaidDiagrams();
  });
</script>
