---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import { Badge } from '@/components/ui/badge';
import {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@/components/ui/breadcrumb';
import { Link } from '@/components/ui/button';
import SectionHeading from '@/components/shared/SectionHeading.astro';
import { getCollection, render } from 'astro:content';
import { getTranslations, defaultLang } from '@/i18n';
import { getTranslatedPath } from '@/i18n/config';
import { mdxComponents } from '@/components/mdx';
import Toggle from '@/components/mdx/Toggle.astro';
import { Icon } from '@/components/shared/Icon';
import {
  ArrowLeft02Icon,
  HomeIcon,
  Globe02Icon,
  SourceCodeIcon,
  UserIcon,
  TimeQuarterIcon,
  UserMultiple02Icon,
  CheckmarkCircle02Icon,
  Bulb,
} from '@hugeicons/core-free-icons';
import { Image } from 'astro:assets';
import { getTechColor, getStatusVariant, formatProjectDate } from '@/lib/projects';
import { cn } from '@/lib/utils';
import { getProjectImage, getProjectImageSafe } from '@/lib/images';

type Project = Awaited<ReturnType<typeof getCollection<'projects'>>>[number];

type StaticPaths = {
  params: { lang: 'en' | undefined; slug: string };
  props: { project: Project };
};

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const staticPaths: StaticPaths[] = [];

  projects.forEach((project) => {
    const [lang, ...slugParts] = project.id.split('/');
    const slug = slugParts.join('/').replace(/\.(md|mdx)$/, '');

    if (lang === 'en') {
      staticPaths.push({ params: { lang: 'en', slug }, props: { project } });
    } else {
      staticPaths.push({ params: { lang: undefined, slug }, props: { project } });
    }
  });

  return staticPaths;
}

const { project } = Astro.props;
const lang = Astro.params.lang ?? defaultLang;
const t = getTranslations(lang);
const translatePath = getTranslatedPath(lang);

const projectImage = getProjectImage(project.data.image);

const { Content } = await render(project);
const {
  title,
  description,
  techStack,
  role,
  links,
  image,
  imageAlt,
  objectFit,
  publishDate,
  status = 'completed',
  duration,
  team,
  highlights,
  lessons,
  gallery,
} = project.data;

const statusKey = `status${status.charAt(0).toUpperCase()}${status.slice(1).replace('-', '')}` as
  'statusCompleted' | 'statusInprogress' | 'statusArchived' | 'statusConcept';

// Prepare gallery images with optimized sources
const galleryImages = gallery?.map((item) => ({
  ...item,
  image: getProjectImageSafe(item.src),
}));

const facts = [
  { label: t.projectsPage.role, value: role, icon: UserIcon },
  { label: t.projectsPage.duration, value: duration, icon: TimeQuarterIcon },
  { label: t.projectsPage.team, value: team, icon: UserMultiple02Icon },
].filter((fact) => fact.value);
const isCover = objectFit === 'cover';
---

<Layout title={`${title} | ${t.projectsPage.title}`} description={description}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: title,
      description: description,
      author: {
        '@type': 'Person',
        name: 'Marek Elmayan',
        url: 'https://melmayan.fr',
      },
      datePublished: publishDate.toISOString(),
      url: Astro.url.href,
      inLanguage: lang,
      keywords: techStack.join(', '),
      ...(image && { image: new URL(image, Astro.site).toString() }),
      ...(links?.demo && { url: links.demo }),
      ...(links?.repo && { codeRepository: links.repo }),
    })}
  />
  <Navbar />
  <main class="container mx-auto max-w-5xl px-4 pt-36 pb-24 md:pt-44">
    <Breadcrumb className="mb-10 font-mono text-xs">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href={translatePath('/')}>
            <Icon
              icon={HomeIcon}
              strokeWidth={2}
              className="motion-safe:hover:animate-wiggle size-4 transition-transform duration-300 ease-in-out"
            />
          </BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href={translatePath('/projects')}>
            {t.nav.projects}
          </BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{title}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>

    <article>
      <header class="mb-12 space-y-8">
        <div class="flex flex-wrap items-center gap-3">
          <Badge variant={getStatusVariant(status)}>
            {t.projectsPage[statusKey]}
          </Badge>
          <time
            datetime={publishDate.toISOString()}
            class="text-muted-foreground font-mono text-xs"
          >
            {formatProjectDate(publishDate, lang)}
          </time>
        </div>

        <SectionHeading as="h1" title={title} subtitle={description} />

        {
          (links?.demo || links?.repo) && (
            <div class="flex flex-col gap-3 sm:flex-row">
              {links.demo && (
                <Link
                  href={links.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="default"
                  size="lg"
                  animation="scale"
                >
                  <Icon icon={Globe02Icon} strokeWidth={2} className="size-4" />
                  {t.projectsPage.viewLive}
                </Link>
              )}
              {links.repo && (
                <Link
                  href={links.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="glass"
                  size="lg"
                  animation="scale"
                >
                  <Icon icon={SourceCodeIcon} strokeWidth={2} className="size-4" />
                  {t.projectsPage.viewCode}
                </Link>
              )}
            </div>
          )
        }
      </header>

      {
        image && (
          <div class="glass mb-8 rounded-3xl p-2">
            <div
              class={cn(
                'bg-pastel-lilac/40 dark:bg-pastel-lilac/10 h-64 overflow-hidden rounded-[1.25rem] md:h-96',
                !isCover && 'p-10 md:p-16'
              )}
            >
              <Image
                src={projectImage}
                fetchpriority="low"
                loading="lazy"
                alt={imageAlt || `Screenshot of ${title}`}
                class="h-full w-full object-cover"
                style={{ objectFit }}
              />
            </div>
          </div>
        )
      }

      <section
        class="glass mb-16 grid gap-6 rounded-3xl p-6 md:grid-cols-[repeat(var(--cols),minmax(0,1fr))] md:p-8"
        style={`--cols: ${facts.length + 1}`}
      >
        {
          facts.map((fact) => (
            <div>
              <p class="eyebrow mb-2 flex items-center gap-2">
                <Icon icon={fact.icon} strokeWidth={2} className="size-3.5" />
                {fact.label}
              </p>
              <p class="text-foreground font-medium">{fact.value}</p>
            </div>
          ))
        }
        <div class={cn(facts.length > 0 && 'md:border-foreground/10 md:border-l md:pl-6')}>
          <h2 class="eyebrow mb-3 font-mono font-normal tracking-[0.08em]">
            {t.projectsPage.techStack}
          </h2>
          <div class="flex flex-wrap gap-1.5">
            {techStack.map((tech) => <Badge variant={getTechColor(tech)}>{tech}</Badge>)}
          </div>
        </div>
      </section>

      {
        highlights && highlights.length > 0 && (
          <section class="glass mx-auto mb-16 max-w-3xl rounded-3xl p-6 md:p-8">
            <h2 class="text-foreground mb-6 text-2xl font-semibold tracking-tight">
              {t.projectsPage.highlights}
            </h2>
            <ul class="space-y-4">
              {highlights.map((highlight) => (
                <li class="flex items-start gap-4">
                  <span class="bg-pastel-mint/60 text-foreground dark:bg-pastel-mint/15 dark:text-pastel-mint grid size-7 shrink-0 place-items-center rounded-full">
                    <Icon icon={CheckmarkCircle02Icon} strokeWidth={2} className="size-4" />
                  </span>
                  <span class="text-foreground/85 leading-relaxed">{highlight}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="prose prose-neutral dark:prose-invert mx-auto max-w-3xl">
        <Content components={{ ...mdxComponents, Toggle }} />
      </div>

      {
        lessons && lessons.length > 0 && (
          <section class="glass relative mx-auto mt-16 max-w-3xl overflow-hidden rounded-3xl p-6 md:p-8">
            <div class="bg-pastel-butter/40 dark:bg-pastel-butter/8 pointer-events-none absolute inset-0" />
            <h2 class="text-foreground relative mb-6 flex items-center gap-3 text-2xl font-semibold tracking-tight">
              <span class="bg-pastel-butter text-ink dark:bg-pastel-butter/15 dark:text-pastel-butter grid size-9 place-items-center rounded-full">
                <Icon icon={Bulb} strokeWidth={2} className="size-4.5" />
              </span>
              {t.projectsPage.lessons}
            </h2>
            <ul class="relative space-y-3">
              {lessons.map((lesson) => (
                <li class="flex items-start gap-3">
                  <span class="text-muted-foreground mt-0.5 font-mono text-xs">&rarr;</span>
                  <span class="text-foreground/85 leading-relaxed">{lesson}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        galleryImages && galleryImages.length > 0 && (
          <section class="mt-20">
            <h2 class="text-foreground mb-8 text-3xl font-semibold tracking-tight md:text-4xl">
              {t.projectsPage.gallery}
            </h2>
            <div class="grid gap-5 sm:grid-cols-2">
              {galleryImages.map((item) =>
                item.image ? (
                  <figure class="glass overflow-hidden rounded-3xl p-2">
                    <Image
                      src={item.image}
                      alt={item.alt}
                      class="aspect-video w-full rounded-[1.25rem] object-cover"
                      loading="lazy"
                    />
                    {item.caption && (
                      <figcaption class="text-muted-foreground px-3 pt-3 pb-2 text-center font-mono text-xs">
                        {item.caption}
                      </figcaption>
                    )}
                  </figure>
                ) : null
              )}
            </div>
          </section>
        )
      }

      <div class="border-foreground/10 mt-20 border-t pt-8">
        <Link href={translatePath('/projects')} variant="glass" size="lg" animation="scale">
          <Icon icon={ArrowLeft02Icon} strokeWidth={2} className="size-4" />
          {t.projectsPage.backToProjects}
        </Link>
      </div>
    </article>
  </main>
</Layout>
<Footer />

<script>
  import { initCopyButtons } from '@/lib/copy-buttons';

  initCopyButtons();
  document.addEventListener('astro:after-swap', initCopyButtons);
</script>
